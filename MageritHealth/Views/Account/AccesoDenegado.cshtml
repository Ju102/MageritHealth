@{
    ViewData["Title"] = "Acceso Restringido";
    // Usamos el layout de login porque es más limpio para pantallas de error
    Layout = "_LoginLayout";
}

<div class="col-12 col-md-10 col-lg-8 col-xl-7">
    <div class="card auth-card border-0 overflow-hidden shadow-sm">
        <div class="row g-0">

            <div class="col-md-5 bg-danger d-flex flex-column align-items-center justify-content-center p-5 text-white position-relative overflow-hidden">

                <div class="position-absolute opacity-25" style="top: -20%; right: -20%; transform: rotate(15deg);">
                    <i class="bi bi-shield-slash-fill" style="font-size: 15rem;"></i>
                </div>

                <div class="position-relative text-center z-1 d-flex flex-column align-items-center">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mb-4 shadow" style="width: 80px; height: 80px; flex-shrink: 0;">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 2.5rem; line-height: 1;"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Área<br>Protegida</h3>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card-body p-4 p-md-5 h-100 d-flex flex-column justify-content-center">

                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold text-uppercase tracking-wide mb-3 align-self-start">
                        Error de Permisos
                    </span>

                    <h2 class="fw-bold text-dark mb-3">Acceso Restringido</h2>

                    <p class="text-muted mb-4 fs-6 lh-lg">
                        Lo sentimos, pero <b>no tienes los permisos necesarios</b> para acceder a esta sección. Esta área está reservada exclusivamente para personal clínico y administrativo autorizado.
                    </p>

                    <div class="d-grid gap-3 mt-auto pt-4 border-top">
                        @if (User.Identity.IsAuthenticated)
                        {
                            string destino = "Paciente";
                            if (User.IsInRole("admin")) destino = "Admin";
                            else if (User.IsInRole("doctor")) destino = "Doctor";

                            <a asp-controller="@destino" asp-action="Dashboard" class="btn btn-auth text-center">
                                <i class="bi bi-house-door-fill me-2"></i>Volver a mi Panel
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-auth text-center">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Ir al Inicio de Sesión
                            </a>
                        }

                        <button onclick="history.back()" class="btn btn-light rounded-pill fw-bold text-secondary shadow-sm">
                            <i class="bi bi-arrow-left me-2"></i>Regresar
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="text-center mt-5">
        <p class="text-muted small mb-1"><i class="bi bi-info-circle me-1"></i> Si crees que esto es un error, contacta con soporte técnico.</p>
        <p class="text-muted small opacity-50">&copy; @DateTime.Now.Year Magerit Health - Control de Seguridad</p>
    </div>
</div>