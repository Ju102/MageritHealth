@model LoginViewModel
@{
    ViewData["Title"] = "Acceso";
    Layout = "_LoginLayout";
}

<div class="desktop-wrapper">
    <div class="auth-side-brand d-none d-lg-flex">
        <div class="clinic-logo-circle">
            <i class="bi bi-hospital-fill"></i>
        </div>
        <h1 class="display-4 fw-bold">Magerit Health</h1>
        <p class="lead">Portal de Gestión de Citas y Prescripciones</p>
        <div class="mt-4 small opacity-75">
            &copy; @DateTime.Now.Year - Clínica Magerit Health
        </div>
    </div>

    <div class="auth-side-form">
        <div class="mb-5">
            <h2 class="fw-bold">¡Bienvenido!</h2>
            <p class="text-muted">Por favor, introduce tus credenciales para acceder.</p>
        </div>

        <form method="post">
            <div class="clinic-input-group">
                <label asp-for="LoginEmail">Correo Electrónico</label>
                <input asp-for="LoginEmail" class="clinic-control" placeholder="usuario@clinica.com" />
                <span class="text-danger small" asp-validation-for="LoginEmail"></span>
            </div>

            <div class="clinic-input-group">
                <label asp-for="LoginPassword">Contraseña</label>
                <input asp-for="LoginPassword" type="password" class="clinic-control" placeholder="••••••••" />
                <span class="text-danger small" asp-validation-for="LoginPassword"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div></div>
                <a href="#" class="small text-decoration-none">¿Problemas con el acceso?</a>
            </div>

            <button type="submit" class="btn-clinic-main">
                <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
            </button>
        </form>
    </div>
</div>