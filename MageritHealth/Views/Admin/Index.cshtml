@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Centro de Control";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Centro de Control Global</h3>
        <p class="text-muted small">Métricas del sistema y gestión de usuarios en tiempo real.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-clinic-main fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Alta Paciente</button>
        <button class="btn btn-clinic-main fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Alta Doctor</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="admin-stat-card border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted fw-bold" style="font-size: 0.8rem;">TOTAL PACIENTES</div>
                    <div class="fs-3 fw-bold text-dark">1,245</div>
                </div>
                <div class="p-2 bg-light rounded text-primary"><i class="bi bi-people fs-4"></i></div>
            </div>
            <div class="small text-success mt-2"><i class="bi bi-arrow-up-right"></i> +12% este mes</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted fw-bold" style="font-size: 0.8rem;">MÉDICOS ACTIVOS</div>
                    <div class="fs-3 fw-bold text-dark">42</div>
                </div>
                <div class="p-2 bg-light rounded text-info"><i class="bi bi-heart-pulse fs-4"></i></div>
            </div>
            <div class="small text-muted mt-2">Repartidos en 4 especialidades</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted fw-bold" style="font-size: 0.8rem;">CITAS HOY</div>
                    <div class="fs-3 fw-bold text-dark">128</div>
                </div>
                <div class="p-2 bg-light rounded text-warning"><i class="bi bi-calendar-check fs-4"></i></div>
            </div>
            <div class="small text-danger mt-2"><i class="bi bi-arrow-down-right"></i> -5% respecto a ayer</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-stat-card border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted fw-bold" style="font-size: 0.8rem;">ESTADO DEL SISTEMA</div>
                    <div class="fs-3 fw-bold text-success">Óptimo</div>
                </div>
                <div class="p-2 bg-light rounded text-success"><i class="bi bi-server fs-4"></i></div>
            </div>
            <div class="small text-muted mt-2">Última copia de seguridad: 04:00 AM</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom pt-3 pb-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0"><i class="bi bi-person-badge me-2 text-primary"></i>Directorio Médico (Recientes)</h6>
                <div class="input-group input-group-sm w-auto">
                    <input type="text" class="form-control" placeholder="Buscar por DNI o Nombre...">
                    <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-admin mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Profesional</th>
                                <th>Especialidad</th>
                                <th>Nº Licencia</th>
                                <th>Último Acceso</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 35px; height: 35px; font-weight: bold;">AP</div>
                                        <div>
                                            <div class="fw-bold text-dark">Dra. Ana Pérez López</div>
                                            <div class="small text-muted">dra.perez@hospital.local</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle fw-bold text-secondary">Cardiología</td>
                                <td class="align-middle">MED-12345</td>
                                <td class="align-middle text-muted small">Hoy, 08:15 AM</td>
                                <td class="align-middle">
                                    <span class="badge bg-soft-green text-success border border-success border-opacity-25 px-2 py-1">Activo</span>
                                </td>
                                <td class="align-middle text-end pe-4">
                                    <button class="btn btn-sm btn-light text-primary border me-1" title="Editar Perfil"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-light text-danger border" title="Desactivar Cuenta"><i class="bi bi-lock"></i></button>
                                </td>
                            </tr>

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 35px; height: 35px; font-weight: bold;">LG</div>
                                        <div>
                                            <div class="fw-bold text-dark">Dr. Luis García Sánchez</div>
                                            <div class="small text-muted">dr.garcia@hospital.local</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle fw-bold text-secondary">Medicina General</td>
                                <td class="align-middle">MED-67890</td>
                                <td class="align-middle text-muted small">Ayer, 18:30 PM</td>
                                <td class="align-middle">
                                    <span class="badge bg-soft-green text-success border border-success border-opacity-25 px-2 py-1">Activo</span>
                                </td>
                                <td class="align-middle text-end pe-4">
                                    <button class="btn btn-sm btn-light text-primary border me-1"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-light text-danger border"><i class="bi bi-lock"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-center">
                <a href="#" class="small text-decoration-none fw-bold">Ver todos los médicos (42)</a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white pt-3 pb-2 border-bottom">
                <h6 class="fw-bold m-0"><i class="bi bi-pie-chart-fill text-info me-2"></i>Demanda por Especialidad</h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-bold">Medicina General</span>
                        <span class="text-muted">45% (58 citas)</span>
                    </div>
                    <div class="progress progress-metric">
                        <div class="progress-bar bg-primary" style="width: 45%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-bold">Pediatría</span>
                        <span class="text-muted">30% (38 citas)</span>
                    </div>
                    <div class="progress progress-metric">
                        <div class="progress-bar bg-info" style="width: 30%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-bold">Cardiología</span>
                        <span class="text-muted">15% (19 citas)</span>
                    </div>
                    <div class="progress progress-metric">
                        <div class="progress-bar bg-warning" style="width: 15%"></div>
                    </div>
                </div>
                <div class="mb-0">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-bold">Dermatología</span>
                        <span class="text-muted">10% (13 citas)</span>
                    </div>
                    <div class="progress progress-metric">
                        <div class="progress-bar bg-secondary" style="width: 10%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-activity text-success me-2"></i>Logs del Sistema</h6>
                <div class="small">
                    <div class="d-flex mb-2 pb-2 border-bottom">
                        <i class="bi bi-key-fill text-warning me-2 mt-1"></i>
                        <div>
                            <span class="d-block fw-bold">Intento de login fallido</span>
                            <span class="text-muted" style="font-size: 0.75rem;">IP: 192.168.1.45 - Hace 5 min</span>
                        </div>
                    </div>
                    <div class="d-flex mb-2 pb-2 border-bottom">
                        <i class="bi bi-prescription2 text-success me-2 mt-1"></i>
                        <div>
                            <span class="d-block fw-bold">Nuevas recetas generadas (12)</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Procesamiento automático - Hace 1 hr</span>
                        </div>
                    </div>
                    <div class="d-flex">
                        <i class="bi bi-person-check-fill text-primary me-2 mt-1"></i>
                        <div>
                            <span class="d-block fw-bold">Nuevo paciente registrado</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Juan Torres - Ayer, 20:30 PM</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>