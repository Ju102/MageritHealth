@model List<MageritHealth.Models.TipoMedicion>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Parámetros de Medición";
}

<div class="container mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h3 class="fw-bold text-dark mb-0">Parámetros Bio-Médicos</h3>
            <p class="text-muted small">Definición de rangos normales y unidades para el seguimiento de pacientes.</p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-indigo fw-bold shadow-sm text-white" data-bs-toggle="modal" data-bs-target="#modalNuevoTipoMedicion">
                <i class="bi bi-activity me-2"></i>Nuevo Parámetro
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Nombre del Parámetro</th>
                            <th class="py-3">Unidad</th>
                            <th class="py-3 text-center">Rango de Referencia</th>
                            <th class="py-3 text-center">Registros Totales</th>
                            <th class="pe-4 py-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var tipo in Model)
                            {
                                var numMediciones = tipo.Mediciones?.Count ?? 0;
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="p-2 bg-indigo bg-opacity-10 rounded-3 text-indigo me-3">
                                                <i class="bi bi-graph-up-arrow text-white fs-5"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@tipo.NombreMedicion</span>
                                                <small class="badge @(tipo.Activo ? "bg-success" : "bg-danger") bg-opacity-10 @(tipo.Activo ? "text-success" : "text-danger") border-0" style="font-size: 0.65rem;">
                                                    @(tipo.Activo ? "ACTIVO" : "INACTIVO")
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 fw-medium text-muted">
                                        @tipo.UnidadMedicion
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <span class="badge bg-light text-dark border fw-normal">Min: @tipo.ValorMinimo</span>
                                            <i class="bi bi-arrow-right text-muted small"></i>
                                            <span class="badge bg-light text-dark border fw-normal">Max: @tipo.ValorMaximo</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge @(numMediciones > 0 ? "bg-primary" : "bg-secondary") bg-opacity-10 @(numMediciones > 0 ? "text-primary" : "text-muted") border rounded-pill px-3">
                                            <i class="bi bi-database me-1"></i> @numMediciones registros
                                        </span>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group shadow-sm rounded">
                                            <button type="button" class="btn btn-white btn-sm border"
                                                    onclick="gestionarEliminacionTipo(@tipo.IdTipoMedicion, '@tipo.NombreMedicion', @numMediciones)"
                                                    title="Eliminar">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-clipboard-x display-4 text-muted d-block mb-3"></i>
                                    <p class="text-muted">No se han definido tipos de medición aún.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ERROR (MEDICIONES EXISTENTES) -->
<div class="modal fade" id="modalErrorTipo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-body p-5 text-center">
                <div class="text-danger mb-4">
                    <i class="bi bi-slash-circle-fill" style="font-size: 4rem;"></i>
                </div>
                <h4 class="fw-bold text-dark">Imposible Eliminar</h4>
                <p class="text-muted">El parámetro <strong id="errTipoNombre" class="text-dark"></strong> tiene datos históricos asociados a pacientes.</p>
                <p class="small text-muted">Para mantener la integridad clínica, no se puede borrar si ya existen registros de salud que lo utilizan.</p>
                <button type="button" class="btn btn-secondary w-100 rounded-3 fw-bold mt-3" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarTipo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-body p-5 text-center">
                <div class="text-warning mb-4">
                    <i class="bi bi-question-diamond-fill" style="font-size: 4rem;"></i>
                </div>
                <h4 class="fw-bold text-dark">¿Confirmar Eliminación?</h4>
                <p class="text-muted">Vas a eliminar el parámetro: <br><strong id="confTipoNombre" class="text-dark"></strong></p>

                <form asp-controller="Admin" asp-action="EliminarTipoMedicion" method="post">
                    <input type="hidden" name="idtipomedicion" id="inputEliminarTipoId" value="" />
                    <div class="d-flex gap-2 mt-4">
                        <button type="button" class="btn btn-light w-100 fw-bold border" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger w-100 fw-bold">Borrar Parámetro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNuevoTipoMedicion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pt-4 px-4">
                <h5 class="fw-bold"><i class="bi bi-plus-circle me-2 text-indigo"></i>Nuevo Parámetro Bio-Médico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <form asp-controller="Admin" asp-action="CrearTipoMedicion" method="post">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Nombre de la Medición</label>
                            <input name="nombre" type="text" class="form-control rounded-3" required placeholder="Ej: Glucosa en ayunas">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Unidad (S.I.)</label>
                            <input name="unidad" type="text" class="form-control rounded-3" required placeholder="Ej: mg/dL">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Valor Mínimo Referencia</label>
                            <input name="minimo" type="number" step="0.01" class="form-control rounded-3" required placeholder="0.00">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Valor Máximo Referencia</label>
                            <input name="maximo" type="number" step="0.01" class="form-control rounded-3" required placeholder="0.00">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-indigo w-100 fw-bold py-2 rounded-3 mt-4 text-white shadow-sm">
                        Registrar Parámetro
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function gestionarEliminacionTipo(id, nombre, count) {
            if (count > 0) {
                document.getElementById('errTipoNombre').innerText = nombre;
                var modalError = new bootstrap.Modal(document.getElementById('modalErrorTipo'));
                modalError.show();
            } else {
                document.getElementById('confTipoNombre').innerText = nombre;
                document.getElementById('inputEliminarTipoId').value = id;
                var modalConf = new bootstrap.Modal(document.getElementById('modalConfirmarTipo'));
                modalConf.show();
            }
        }
    </script>
}

<style>
    :root {
        --bs-indigo: #6610f2;
    }

    .text-indigo {
        color: var(--bs-indigo) !important;
    }

    .bg-indigo {
        background-color: var(--bs-indigo) !important;
    }

    .btn-indigo {
        background-color: var(--bs-indigo);
        border-color: var(--bs-indigo);
    }

        .btn-indigo:hover {
            background-color: #520dc2;
            border-color: #520dc2;
        }

    .btn-white {
        background-color: #fff;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(102, 16, 242, 0.02);
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "•";
        color: #dee2e6;
    }
</style>