@using MageritHealth.Models
@model Usuario

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h3 class="fw-bold text-dark mb-0">Gestión de Perfil Propio</h3>
            <p class="text-muted small">Revisa tus credenciales de acceso y datos personales de administración.</p>
        </div>
        <a asp-controller="Admin" asp-action="EditarPerfil" class="btn btn-primary fw-bold shadow-sm px-4 py-2">
            <i class="bi bi-pencil-square me-2"></i>Editar Mis Datos
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 text-center p-4 h-100">
                <div class="card-body">
                    <div class="avatar-huge bg-primary bg-opacity-10 text-primary mx-auto mb-3 shadow-sm" style="width: 100px; height: 100px; font-size: 2rem; border-radius: 25px;">
                        @(Model.Nombre[0])@(Model.Apellido1[0])
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@Model.Nombre @Model.Apellido1</h4>
                    <span class="badge bg-dark bg-opacity-10 text-dark border border-dark rounded-pill px-3 py-2 mb-4">
                        <i class="bi bi-shield-lock-fill me-1"></i> @Model.Rol.ToUpper()
                    </span>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="text-start">
                        <div class="mb-3">
                            <label class="small fw-bold text-muted text-uppercase d-block mb-1">Correo Electrónico</label>
                            <p class="text-dark mb-0"><i class="bi bi-envelope me-2 text-primary"></i>@Model.Email</p>
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold text-muted text-uppercase d-block mb-1">Identificación</label>
                            <p class="text-dark mb-0"><i class="bi bi-card-text me-2 text-primary"></i>@Model.Dni</p>
                        </div>
                        <div class="mb-0">
                            <label class="small fw-bold text-muted text-uppercase d-block mb-1">Miembro desde</label>
                            <p class="text-dark mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>@Model.FechaCreacion.ToString("dd MMMM, yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-lines-fill me-2 text-primary"></i>Información Detallada
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border border-light bg-light bg-opacity-25">
                                <label class="small fw-bold text-muted d-block mb-1">Nombre Completo</label>
                                <span class="text-dark fw-medium">@Model.Nombre @Model.Apellido1 @Model.Apellido2</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border border-light bg-light bg-opacity-25">
                                <label class="small fw-bold text-muted d-block mb-1">Teléfono de Contacto</label>
                                <span class="text-dark fw-medium">@Model.Telefono</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border border-light bg-light bg-opacity-25">
                                <label class="small fw-bold text-muted d-block mb-1">Fecha de Nacimiento</label>
                                <span class="text-dark fw-medium">@Model.FechaNacimiento.ToString("dd 'de' MMMM 'de' yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border border-light bg-light bg-opacity-25">
                                <label class="small fw-bold text-muted d-block mb-1">Género</label>
                                <span class="text-dark fw-medium text-capitalize">@Model.Genero</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 rounded-4 border border-light bg-light bg-opacity-25">
                                <label class="small fw-bold text-muted d-block mb-1">Dirección Registrada</label>
                                <span class="text-dark fw-medium">@Model.Direccion</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="bi bi-info-circle-fill text-primary fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-primary mb-1">Nota de Seguridad</h6>
                                <p class="text-muted small mb-0">Como administrador, tu cuenta tiene acceso de lectura y escritura en todos los módulos. Asegúrate de mantener tu contraseña actualizada.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-huge {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "•";
        color: #dee2e6;
    }
</style>
</style>