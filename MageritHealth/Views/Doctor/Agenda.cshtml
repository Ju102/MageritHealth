@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Mi Agenda";
}

<div class="container mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h3 class="fw-bold text-dark mb-0">Agenda Médica</h3>
            <p class="text-muted small">Gestiona y revisa tus consultas programadas.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary bg-white shadow-sm rounded-3 px-3 py-2" title="Día anterior">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-primary fw-bold shadow-sm rounded-3 px-4 py-2">
                <i class="bi bi-calendar-event me-2"></i>Hoy: 17 Mar 2026
            </button>
            <button class="btn btn-outline-secondary bg-white shadow-sm rounded-3 px-3 py-2" title="Día siguiente">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="doctor-card p-3 mb-4 shadow-sm border-0 d-flex flex-wrap gap-2 align-items-center bg-white">
                <span class="fw-bold text-muted small me-2"><i class="bi bi-funnel me-1"></i> Filtros:</span>
                <button class="btn btn-sm btn-dark rounded-pill px-3">Todas</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Pendientes</button>
                <button class="btn btn-sm btn-outline-success rounded-pill px-3">Completadas</button>
                <div class="ms-auto input-group" style="max-width: 250px;">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search small"></i></span>
                    <input type="text" class="form-control form-control-sm bg-light border-start-0 ps-0" placeholder="Buscar paciente...">
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-end me-3 pt-3" style="min-width: 60px;">
                    <h5 class="fw-bold text-dark mb-0">09:00</h5>
                    <small class="text-muted">30 min</small>
                </div>
                <div class="doctor-card p-3 w-100 border-start border-success border-5 shadow-sm bg-white opacity-75">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small mb-2">Completada</span>
                            <h6 class="fw-bold text-dark mb-1">Carlos Mendoza Ruiz</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: 11223344A | <i class="bi bi-clipboard-pulse ms-2 me-1"></i>Revisión de análisis</p>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary fw-bold shadow-sm"><i class="bi bi-file-earmark-medical me-1"></i>Ver Informe</button>
                    </div>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-end me-3 pt-3" style="min-width: 60px;">
                    <h5 class="fw-bold text-dark mb-0">09:30</h5>
                    <small class="text-muted">30 min</small>
                </div>
                <div class="doctor-card p-3 w-100 border-start border-success border-5 shadow-sm bg-white opacity-75">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small mb-2">Completada</span>
                            <h6 class="fw-bold text-dark mb-1">Elena Torres Blanco</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: 22334455B | <i class="bi bi-clipboard-pulse ms-2 me-1"></i>Control de tensión</p>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary fw-bold shadow-sm"><i class="bi bi-file-earmark-medical me-1"></i>Ver Informe</button>
                    </div>
                </div>
            </div>

            <div class="d-flex mb-3 position-relative">
                <div class="position-absolute w-100 border-top border-primary" style="top: -10px; z-index: 0; border-top-style: dashed !important;">
                    <span class="position-absolute bg-primary text-white rounded-pill small px-2 py-1" style="top: -12px; left: 0;">Ahora</span>
                </div>

                <div class="text-end me-3 pt-3 position-relative" style="min-width: 60px; z-index: 1;">
                    <h5 class="fw-bold text-primary mb-0">10:00</h5>
                    <small class="text-primary fw-bold">30 min</small>
                </div>
                <div class="doctor-card p-4 w-100 border-start border-primary border-5 shadow bg-white position-relative" style="z-index: 1;">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3">
                        <div>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-2 mb-2 animate-pulse">
                                <i class="bi bi-record-circle-fill me-1"></i> En Curso
                            </span>
                            <h5 class="fw-bold text-dark mb-1">María Díaz Martín</h5>
                            <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: 44444444D | <i class="bi bi-telephone ms-2 me-1"></i>600 777 888</p>
                        </div>
                        <div class="mt-3 mt-sm-0">
                            <a href="#" class="btn btn-primary fw-bold shadow-sm px-4 py-2"><i class="bi bi-play-fill me-1"></i>Continuar Consulta</a>
                        </div>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3">
                        <span class="fw-bold text-dark small d-block mb-1">Motivo:</span>
                        <p class="text-muted small fst-italic mb-0">"Dolor leve en el pecho y episodios de estrés."</p>
                    </div>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-end me-3 pt-3" style="min-width: 60px;">
                    <h5 class="fw-bold text-dark mb-0">10:30</h5>
                    <small class="text-muted">30 min</small>
                </div>
                <div class="doctor-card p-3 w-100 border-start border-info border-5 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-0">
                        <div>
                            <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill small mb-2">Programada (Sala de espera)</span>
                            <h6 class="fw-bold text-dark mb-1">Javier López Fernández</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: 55667788C | <i class="bi bi-clipboard-pulse ms-2 me-1"></i>Primera visita</p>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-info fw-bold shadow-sm me-2" title="Ver Ficha Previa"><i class="bi bi-eye"></i></button>
                            <button class="btn btn-sm btn-info text-white fw-bold shadow-sm">Llamar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-end me-3 pt-3" style="min-width: 60px;">
                    <h5 class="fw-bold text-secondary mb-0">11:00</h5>
                    <small class="text-muted">30 min</small>
                </div>
                <div class="doctor-card p-3 w-100 border-start border-secondary border-5 shadow-sm bg-light text-center">
                    <div class="text-muted fw-bold"><i class="bi bi-cup-hot-fill me-2"></i> Descanso / Tareas Administrativas</div>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-end me-3 pt-3" style="min-width: 60px;">
                    <h5 class="fw-bold text-muted text-decoration-line-through mb-0">11:30</h5>
                    <small class="text-muted">30 min</small>
                </div>
                <div class="doctor-card p-3 w-100 border-start border-danger border-5 shadow-sm bg-white opacity-50">
                    <div class="d-flex justify-content-between align-items-center mb-0">
                        <div>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill small mb-2">Cancelada por el paciente</span>
                            <h6 class="fw-bold text-muted text-decoration-line-through mb-1">Sofía Ramírez Vega</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: 99887766Z</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="doctor-card p-4 shadow-sm border-0 mb-4 bg-white">
                <h6 class="fw-bold text-dark border-bottom pb-3 mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Resumen de Jornada</h6>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-bold small">Total Citas:</span>
                    <span class="badge bg-dark rounded-pill fs-6 px-3">8</span>
                </div>

                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 25%" aria-valuenow="2" aria-valuemin="0" aria-valuemax="8" title="Completadas: 2"></div>
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 12.5%" aria-valuenow="1" aria-valuemin="0" aria-valuemax="8" title="En curso: 1"></div>
                    <div class="progress-bar bg-info" role="progressbar" style="width: 50%" aria-valuenow="4" aria-valuemin="0" aria-valuemax="8" title="Pendientes: 4"></div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: 12.5%" aria-valuenow="1" aria-valuemin="0" aria-valuemax="8" title="Canceladas: 1"></div>
                </div>

                <ul class="list-unstyled small mb-0">
                    <li class="mb-2 d-flex justify-content-between"><span class="text-success fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Completadas</span> <span>2</span></li>
                    <li class="mb-2 d-flex justify-content-between"><span class="text-primary fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>En Curso</span> <span>1</span></li>
                    <li class="mb-2 d-flex justify-content-between"><span class="text-info fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Pendientes</span> <span>4</span></li>
                    <li class="d-flex justify-content-between"><span class="text-danger fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Canceladas</span> <span>1</span></li>
                </ul>
            </div>

            <div class="doctor-card p-4 shadow-sm border-0 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Marzo 2026</h6>
                    <div>
                        <button class="btn btn-sm btn-link text-muted p-0 me-2"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-sm btn-link text-muted p-0"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>

                <div class="d-grid text-center small fw-bold text-muted mb-2" style="grid-template-columns: repeat(7, 1fr);">
                    <div>L</div><div>M</div><div>X</div><div>J</div><div>V</div><div>S</div><div>D</div>
                </div>

                <div class="d-grid text-center small" style="grid-template-columns: repeat(7, 1fr); gap: 5px;">
                    <div class="text-muted opacity-25 p-1"></div>
                    <div class="text-muted opacity-25 p-1"></div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">1</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">2</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">3</div>
                    <div class="p-1 rounded text-muted">4</div>
                    <div class="p-1 rounded text-muted">5</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">6</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">7</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">8</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">9</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">10</div>
                    <div class="p-1 rounded text-muted">11</div>
                    <div class="p-1 rounded text-muted">12</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">13</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">14</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">15</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">16</div>
                    <div class="p-1 rounded bg-primary text-white fw-bold shadow-sm">17</div> <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">18</div>
                    <div class="p-1 rounded text-muted">19</div>
                    <div class="p-1 rounded text-muted">20</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">21</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">22</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">23</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">24</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">25</div>
                    <div class="p-1 rounded text-muted">26</div>
                    <div class="p-1 rounded text-muted">27</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">28</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">29</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">30</div>
                    <div class="p-1 rounded text-dark hover-bg-light cursor-pointer">31</div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Clases de utilidad para el mini-calendario */
    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    /* Animación sutil para el indicador "En Curso" */
    @@keyframes pulse-opacity {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
        }
    }

    .animate-pulse i {
        animation: pulse-opacity 2s infinite;
    }
</style>