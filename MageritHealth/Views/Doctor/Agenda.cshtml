@using MageritHealth.Models.ViewModels
@model DoctorAgendaViewModel

@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Mi Agenda";
}

<div class="container mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h3 class="fw-bold text-dark mb-0">Agenda Médica</h3>
            <p class="text-muted small">Gestiona y revisa tus consultas programadas.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary fw-bold shadow-sm rounded-3 px-4 py-2" disabled>
                <i class="bi bi-calendar-event me-2"></i>Hoy, @Model.FechaDada.ToString("dd MMM")
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            @if (Model.Citas != null && Model.Citas.Any())
            {
                bool hayCitaEnCurso = Model.Citas.Any(c => c.Estado.Equals("Progreso", StringComparison.OrdinalIgnoreCase) || c.Estado.Equals("En Curso", StringComparison.OrdinalIgnoreCase));

                bool primeraProgramadaEncontrada = false;

                DateTime ahora = DateTime.Now;

                foreach (var cita in Model.Citas.OrderBy(c => c.FechaHora))
                {
                    // Lógica visual basada en el estado
                    string borderClass = "border-info";
                    string badgeClass = "bg-info text-white";
                    string rowOpacity = "";

                    bool enCurso = cita.Estado.Equals("Progreso", StringComparison.OrdinalIgnoreCase) || cita.Estado.Equals("En Curso", StringComparison.OrdinalIgnoreCase);
                    bool esProgramada = cita.Estado.Equals("Programada", StringComparison.OrdinalIgnoreCase);

                    bool esCitaDeHoy = cita.FechaHora.Date == ahora.Date;

                    DateTime horaMinimaParaIniciar = cita.FechaHora.AddMinutes(-5);
                    bool estaEnTiempoParaIniciar = ahora >= horaMinimaParaIniciar;

                    bool esSiguienteParaIniciar = esProgramada && !hayCitaEnCurso && !primeraProgramadaEncontrada && esCitaDeHoy && estaEnTiempoParaIniciar;

                    if (esProgramada && !primeraProgramadaEncontrada)
                    {
                        primeraProgramadaEncontrada = true;
                    }

                    if (cita.Estado.Equals("Completada", StringComparison.OrdinalIgnoreCase))
                    {
                        borderClass = "border-success";
                        badgeClass = "bg-success bg-opacity-10 text-success border border-success";
                        rowOpacity = "opacity-75";
                    }
                    else if (cita.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase))
                    {
                        borderClass = "border-danger";
                        badgeClass = "bg-danger bg-opacity-10 text-danger border border-danger";
                        rowOpacity = "opacity-50";
                    }
                    else if (enCurso)
                    {
                        borderClass = "border-warning";
                        badgeClass = "bg-warning bg-opacity-25 text-dark border border-warning animate-pulse";
                    }
                    else if (esProgramada && !esSiguienteParaIniciar)
                    {
                        borderClass = "border-info";
                        badgeClass = "bg-info text-white";
                    }

                    <div class="d-flex mb-3 position-relative">

                        @if (enCurso)
                        {
                            <div class="position-absolute w-100 border-top border-warning" style="top: -10px; z-index: 0; border-top-style: dashed !important;">
                                <span class="position-absolute bg-warning text-dark fw-bold rounded-pill small px-2 py-1 shadow-sm" style="top: -12px; left: 0;">Ahora</span>
                            </div>
                        }

                        <div class="text-end me-3 pt-3 position-relative" style="min-width: 60px; z-index: 1;">
                            <h5 class="fw-bold @(enCurso ? "text-dark fs-4" : (cita.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase) ? "text-muted text-decoration-line-through" : "text-dark")) mb-0">@cita.FechaHora.ToString("HH:mm")</h5>
                            <small class="@(enCurso ? "text-warning fw-bold" : "text-muted")">30 min</small>
                        </div>

                        <div class="doctor-card p-3 w-100 border-start @borderClass border-5 shadow-sm bg-white @rowOpacity position-relative" style="z-index: 1;">

                            @if (enCurso)
                            {
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3">
                                    <div>
                                        <span class="badge @badgeClass rounded-pill px-3 py-2 mb-2">
                                            <i class="bi bi-record-circle-fill text-danger me-1"></i> En Curso
                                        </span>
                                        <h5 class="fw-bold text-dark mb-1">@(cita.Paciente?.Nombre) @(cita.Paciente?.Apellido1)</h5>
                                        <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: @(cita.Paciente?.Dni) | <i class="bi bi-telephone ms-2 me-1"></i>@(cita.Paciente?.Telefono)</p>
                                    </div>
                                    <div class="mt-3 mt-sm-0">
                                        <a asp-controller="Doctor" asp-action="Consulta" asp-route-id="@cita.IdCita" class="btn btn-warning fw-bold text-dark shadow-sm px-4 py-2">
                                            <i class="bi bi-play-fill me-1"></i>Continuar Consulta
                                        </a>
                                    </div>
                                </div>
                                <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3">
                                    <span class="fw-bold text-dark small d-block mb-1">Motivo:</span>
                                    <p class="text-muted small fst-italic mb-0">"@cita.Motivo"</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mb-0">
                                    <div>
                                        <span class="badge @badgeClass rounded-pill small mb-2">@cita.Estado.ToUpper()</span>
                                        <h6 class="fw-bold @(cita.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase) ? "text-muted text-decoration-line-through" : "text-dark") mb-1">@(cita.Paciente?.Nombre) @(cita.Paciente?.Apellido1)</h6>
                                        <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i>DNI: @(cita.Paciente?.Dni) @(!cita.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase) ? $"| {cita.Motivo}" : "")</p>
                                    </div>

                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (esProgramada)
                                        {
                                            @if (esSiguienteParaIniciar)
                                            {
                                                <button class="btn btn-sm btn-outline-danger fw-bold shadow-sm" title="Marcar paciente como ausente" data-bs-toggle="tooltip">
                                                    <i class="bi bi-person-x"></i> Ausente
                                                </button>
                                                <a asp-controller="Doctor" asp-action="Consulta" asp-route-id="@cita.IdCita" class="btn btn-sm btn-info text-white fw-bold shadow-sm">
                                                    <i class="bi bi-play-fill me-1"></i>Iniciar
                                                </a>
                                            }
                                            else
                                            {
                                                string titleMensaje = "";
                                                if (hayCitaEnCurso)
                                                {
                                                    titleMensaje = "Debes finalizar la consulta actual para iniciar esta.";
                                                }
                                                else if (!esCitaDeHoy)
                                                {
                                                    titleMensaje = "Solo puedes iniciar citas programadas para el día de hoy.";
                                                }
                                                else if (!estaEnTiempoParaIniciar)
                                                {
                                                    titleMensaje = "Podrás iniciar la consulta 5 minutos antes de la hora programada.";
                                                }
                                                else
                                                {
                                                    titleMensaje = "Debes atender la cita anterior primero.";
                                                }

                                                <button class="btn btn-sm btn-light text-muted fw-bold shadow-sm" disabled title="@titleMensaje" data-bs-toggle="tooltip">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                        }
                                        else if (cita.Estado.Equals("Completada", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-sm btn-outline-secondary fw-bold shadow-sm"><i class="bi bi-file-earmark-medical me-1"></i>Ver Informe</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center p-5 border rounded-4 bg-light text-muted">
                    <i class="bi bi-calendar-x fs-1 opacity-50 mb-3 d-block"></i>
                    <h5 class="fw-bold">Sin citas programadas</h5>
                    <p class="small mb-0">No hay pacientes agendados para este día.</p>
                </div>
            }

        </div>
        <div class="col-lg-4">

            <div class="doctor-card p-4 shadow-sm border-0 mb-4 bg-white">
                <h6 class="fw-bold text-dark border-bottom pb-3 mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Resumen de Jornada</h6>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-bold small">Total Citas:</span>
                    <span class="badge bg-dark rounded-pill fs-6 px-3">@Model.TotalCitas</span>
                </div>

                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PorcentajeCompletadas" title="Completadas: @Model.CitasCompletadas"></div>
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @Model.PorcentajeEnCurso" title="En curso: @Model.CitasEnCurso"></div>
                    <div class="progress-bar bg-info" role="progressbar" style="width: @Model.PorcentajePendientes" title="Pendientes: @Model.CitasPendientes"></div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @Model.PorcentajeCanceladas" title="Canceladas: @Model.CitasCanceladas"></div>
                </div>

                <ul class="list-unstyled small mb-0">
                    <li class="mb-2 d-flex justify-content-between"><span class="text-success fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Completadas</span> <span>@Model.CitasCompletadas</span></li>
                    <li class="mb-2 d-flex justify-content-between"><span class="text-warning fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>En Curso</span> <span>@Model.CitasEnCurso</span></li>
                    <li class="mb-2 d-flex justify-content-between"><span class="text-info fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Pendientes</span> <span>@Model.CitasPendientes</span></li>
                    <li class="d-flex justify-content-between"><span class="text-danger fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>Canceladas</span> <span>@Model.CitasCanceladas</span></li>
                </ul>
            </div>
            <!-- CALENDARIO ESTÁTICO (MES ACTUAL) -->
            <div class="doctor-card p-4 shadow-sm border-0 bg-white">
                @{
                    // Lógica estática basada en el mes actual
                    DateTime mesActual = DateTime.Now;
                    DateTime primerDiaDelMes = new DateTime(mesActual.Year, mesActual.Month, 1);
                    int diasEnElMes = DateTime.DaysInMonth(mesActual.Year, mesActual.Month);

                    // En C#, DayOfWeek.Sunday es 0. Transformamos para que Lunes sea 0 y Domingo 6.
                    int huecosEnBlanco = ((int)primerDiaDelMes.DayOfWeek + 6) % 7;
                }

                <div class="d-flex justify-content-center align-items-center mb-3 pb-2 border-bottom">
                    <h6 class="fw-bold text-dark mb-0 text-capitalize">
                        @mesActual.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                    </h6>
                </div>

                <!-- Cabecera de días (L M X J V S D) -->
                <div class="d-grid text-center small fw-bold text-muted mb-2" style="grid-template-columns: repeat(7, 1fr);">
                    <div>L</div><div>M</div><div>X</div><div>J</div><div>V</div><div>S</div><div>D</div>
                </div>

                <div class="d-grid text-center small" style="grid-template-columns: repeat(7, 1fr); gap: 5px;">

                    @for (int i = 0; i < huecosEnBlanco; i++)
                    {
                        <div class="text-muted opacity-25 p-1"></div>
                    }

                    @for (int dia = 1; dia <= diasEnElMes; dia++)
                    {
                        DateTime fechaBucle = new DateTime(mesActual.Year, mesActual.Month, dia);
                        bool esFechaDadaSeleccionada = fechaBucle.Date == Model.FechaDada.Date;
                        bool esFinDeSemana = fechaBucle.DayOfWeek == DayOfWeek.Saturday || fechaBucle.DayOfWeek == DayOfWeek.Sunday;

                        if (esFechaDadaSeleccionada)
                        {
                            <a class="p-1 rounded bg-primary text-white fw-bold shadow-sm text-decoration-none d-block">
                                @dia
                            </a>
                        }
                        else if (esFinDeSemana)
                        {
                            <a class="p-1 rounded text-muted text-decoration-none d-block" style="background-color: #f8f9fa;">
                                @dia
                            </a>
                        }
                        else
                        {
                            <a class="p-1 rounded text-muted text-decoration-none d-block">
                                @dia
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    @@keyframes pulse-opacity {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
        }
    }

    .animate-pulse i {
        animation: pulse-opacity 2s infinite;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}