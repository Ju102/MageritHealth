@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Consulta: María Díaz Martín";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div class="d-flex align-items-center">
        <a href="#" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Volver</a>
        <h3 class="fw-bold mb-0">Consulta en Curso</h3>
        <span class="badge bg-danger ms-3 animate-pulse"><i class="bi bi-record-circle-fill me-1"></i> Grabando tiempo...</span>
    </div>
    <div>
        <button class="btn btn-outline-danger me-2"><i class="bi bi-x-circle me-1"></i> Cancelar</button>
        <button class="btn btn-success fw-bold px-4"><i class="bi bi-check2-all me-2"></i> Finalizar Consulta</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="patient-sidebar p-4 mb-4">
            <div class="text-center border-bottom pb-3 mb-3">
                <div class="patient-avatar-l shadow-sm">MD</div>
                <h5 class="fw-bold mb-0">María Díaz Martín</h5>
                <p class="text-muted small mb-2">Paciente #44444</p>
                <span class="badge bg-light text-dark border"><i class="bi bi-gender-female text-pink"></i> Mujer, 31 años</span>
            </div>

            <div class="small">
                <div class="mb-2"><strong class="text-muted d-block" style="font-size: 0.75rem;">DNI</strong> 44444444D</div>
                <div class="mb-2"><strong class="text-muted d-block" style="font-size: 0.75rem;">TELÉFONO</strong> 600 777 888</div>
                <div class="mb-2"><strong class="text-muted d-block" style="font-size: 0.75rem;">SEGURO</strong> Sanitas (INS-889900)</div>
                <div class="mb-2"><strong class="text-muted d-block" style="font-size: 0.75rem;">ALERGIAS</strong> <span class="text-danger fw-bold">Penicilina</span></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-3">
                <h6 class="fw-bold small text-muted mb-2"><i class="bi bi-capsule me-2"></i>Medicación Activa</h6>
                <div class="bg-white p-2 rounded border-start border-primary border-3 mb-2 small">
                    <strong>Lorazepam 1mg</strong><br>
                    <span class="text-muted">Finaliza: 24/02/2026</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card border-0 shadow-sm h-100">
            <ul class="nav nav-tabs clinic-tabs px-3 pt-2 bg-white" id="medicalTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="consulta-tab" data-bs-toggle="tab" data-bs-target="#consulta" type="button" role="tab"><i class="bi bi-pencil-square me-2"></i>Notas de Consulta</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="recetas-tab" data-bs-toggle="tab" data-bs-target="#recetas" type="button" role="tab"><i class="bi bi-file-medical me-2"></i>Recetas (1)</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="historial-tab" data-bs-toggle="tab" data-bs-target="#historial" type="button" role="tab"><i class="bi bi-clock-history me-2"></i>Historial Previo</button>
                </li>
            </ul>

            <div class="tab-content p-4 bg-white" id="medicalTabsContent">

                <div class="tab-pane fade show active" id="consulta" role="tabpanel">
                    <div class="mb-3 p-3 bg-light rounded border-start border-warning border-3">
                        <span class="fw-bold small text-uppercase text-muted d-block mb-1">Motivo de la Cita (Escrito por el paciente)</span>
                        <span class="fs-6">"Dolor leve en el pecho y episodios de estrés."</span>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-journal-text me-2"></i>Anotaciones Clínicas (Doctor Notes)</label>
                            <textarea class="form-control clinical-textarea w-100" placeholder="Escriba la anamnesis, exploración física y juicio clínico aquí..."></textarea>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="recetas" role="tabpanel">
                    <div class="mb-4">
                        <h6 class="fw-bold text-muted mb-3">Emitidas en esta consulta</h6>
                        <div class="list-item-clinic border border-success border-opacity-25" style="border-left: 4px solid #28a745 !important;">
                            <div>
                                <div class="fw-bold text-dark fs-5">Lorazepam</div>
                                <div class="text-muted">1mg por la noche</div>
                                <div class="small"><i class="bi bi-info-circle me-1"></i>Tomar en caso de ansiedad o insomnio</div>
                            </div>
                            <div class="text-end">
                                <div class="badge bg-light text-dark mb-1">10/02/2026 - 24/02/2026</div>
                                <div>
                                    <button class="btn btn-sm btn-link text-danger"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="prescription-form-box">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-plus-circle me-2"></i>Añadir Nueva Prescripción</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Medicamento</label>
                                <input type="text" class="form-control clinic-control" placeholder="Ej: Ibuprofeno">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Dosis</label>
                                <input type="text" class="form-control clinic-control" placeholder="Ej: 600mg cada 8 horas">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Instrucciones al paciente</label>
                                <input type="text" class="form-control clinic-control" placeholder="Ej: Tomar con las comidas">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Fecha Inicio</label>
                                <input type="date" class="form-control clinic-control" value="2026-02-25">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Fecha Fin</label>
                                <input type="date" class="form-control clinic-control">
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button class="btn btn-primary w-100 fw-bold"><i class="bi bi-plus-lg me-2"></i>Añadir Receta</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="historial" role="tabpanel">
                    <h6 class="fw-bold text-muted mb-3">Visitas Anteriores</h6>
                    <div class="p-3 border rounded mb-3 bg-light opacity-75">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold">15 Dic 2025 - Cardiología</span>
                            <span class="badge bg-secondary">Dra. Ana Pérez</span>
                        </div>
                        <p class="small text-muted mb-0">Revisión rutinaria. ECG normal. Se recomienda control de peso y dieta baja en sal.</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>