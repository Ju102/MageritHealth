@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Consulta en Curso";
}

<div class="container mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 border-bottom pb-4">
        <div class="d-flex align-items-center mb-3 mb-md-0">
            <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-outline-secondary rounded-circle p-2 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" title="Volver a la Agenda">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <div class="d-flex align-items-center">
                    <h3 class="fw-bold text-dark mb-0 me-3">Consulta en Curso</h3>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill d-flex align-items-center py-2 px-3">
                        <i class="bi bi-record-circle-fill me-2"></i> Grabando tiempo...
                    </span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-light text-danger fw-bold shadow-sm rounded-3 px-3">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </button>
            <button class="btn btn-success fw-bold shadow-sm rounded-3 px-4">
                <i class="bi bi-check2-all me-2"></i> Finalizar Consulta
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="doctor-card p-4 mb-4 border-start border-primary border-5 shadow-sm text-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3 fw-bold fs-3" style="width: 80px; height: 80px;">
                    MD
                </div>
                <h5 class="fw-bold text-dark mb-1">María Díaz Martín</h5>
                <p class="text-muted small mb-3">ID Paciente: #44444</p>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mb-4">
                    <i class="bi bi-gender-female text-danger me-1"></i> Mujer, 31 años
                </span>

                <div class="text-start border-top pt-3">
                    <div class="mb-3">
                        <small class="text-muted fw-bold d-block text-uppercase mb-1">DNI</small>
                        <div class="text-dark small fw-medium">44444444D</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted fw-bold d-block text-uppercase mb-1">Teléfono</small>
                        <div class="text-dark small fw-medium">600 777 888</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted fw-bold d-block text-uppercase mb-1">Seguro</small>
                        <div class="text-dark small fw-medium">Sanitas (INS-889900)</div>
                    </div>
                    <div class="mb-0">
                        <small class="text-muted fw-bold d-block text-uppercase mb-1">Alergias Conocidas</small>
                        <div class="p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 d-inline-block mt-1">
                            <span class="text-danger fw-bold small"><i class="bi bi-exclamation-triangle-fill me-1"></i>Penicilina</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="doctor-card p-4 border-start border-success border-5 shadow-sm">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-capsule-pill text-success me-2"></i>Medicación Activa</h6>

                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 py-2 border-0 bg-transparent">
                        <div class="fw-bold text-dark mb-1">Lorazepam <span class="text-muted fs-6 fw-normal">(1mg)</span></div>
                        <div class="text-muted small"><i class="bi bi-calendar-x me-1"></i>Finaliza: 24/02/2026</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="doctor-card shadow-sm border-0 rounded-4 h-100 d-flex flex-column overflow-hidden">

                <div class="bg-light px-4 pt-3 border-bottom">
                    <ul class="nav nav-tabs border-bottom-0 gap-2" id="medicalTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-secondary border-0 border-bottom border-primary border-3 bg-transparent rounded-0 pb-3" id="consulta-tab" data-bs-toggle="tab" data-bs-target="#consulta" type="button" role="tab">
                                <i class="bi bi-pencil-square me-2"></i>Notas de Consulta
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-secondary border-0 border-bottom border-transparent border-3 bg-transparent rounded-0 pb-3" id="recetas-tab" data-bs-toggle="tab" data-bs-target="#recetas" type="button" role="tab">
                                <i class="bi bi-file-medical me-2"></i>Recetas <span class="badge bg-secondary ms-1 rounded-pill">1</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-secondary border-0 border-bottom border-transparent border-3 bg-transparent rounded-0 pb-3" id="historial-tab" data-bs-toggle="tab" data-bs-target="#historial" type="button" role="tab">
                                <i class="bi bi-clock-history me-2"></i>Historial Previo
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4 p-md-5 flex-grow-1">
                    <div class="tab-content" id="medicalTabsContent">

                        <div class="tab-pane fade show active" id="consulta" role="tabpanel">
                            <div class="p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3 mb-4">
                                <span class="fw-bold small text-uppercase text-warning text-darken d-block mb-2">
                                    <i class="bi bi-chat-left-quote-fill me-1"></i> Motivo de la Cita (Escrito por el paciente)
                                </span>
                                <p class="text-dark fw-medium fst-italic mb-0">"Dolor leve en el pecho y episodios de estrés."</p>
                            </div>

                            <form>
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-primary mb-3 d-block border-bottom pb-2">
                                        <i class="bi bi-journal-text me-2"></i>Anotaciones Clínicas
                                    </label>
                                    <textarea class="form-control bg-light border-0 shadow-sm rounded-4 p-4" rows="12" placeholder="Escriba la anamnesis, exploración física, diagnóstico y plan de tratamiento aquí..."></textarea>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="recetas" role="tabpanel">

                            <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Emitidas en esta consulta</h6>
                            <div class="doctor-card p-3 mb-5 border-start border-success border-5 shadow-sm d-flex justify-content-between align-items-center bg-success bg-opacity-10 border-0 border-start">
                                <div>
                                    <div class="fw-bold text-dark fs-5 mb-1">Lorazepam</div>
                                    <div class="text-muted small fw-bold mb-1">1mg por la noche</div>
                                    <div class="small text-dark"><i class="bi bi-info-circle text-primary me-1"></i>Tomar en caso de ansiedad o insomnio</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-white text-dark border shadow-sm mb-2 px-3 py-2 d-block">10/02/2026 <i class="bi bi-arrow-right mx-1"></i> 24/02/2026</span>
                                    <button class="btn btn-sm btn-outline-danger border-0 fw-bold"><i class="bi bi-trash3 me-1"></i>Eliminar</button>
                                </div>
                            </div>

                            <div class="p-4 bg-light rounded-4 border">
                                <h6 class="fw-bold text-primary mb-4"><i class="bi bi-plus-circle-fill me-2"></i>Añadir Nueva Prescripción</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark">Medicamento</label>
                                        <input type="text" class="form-control bg-white shadow-sm border-0" placeholder="Ej: Ibuprofeno">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark">Dosis</label>
                                        <input type="text" class="form-control bg-white shadow-sm border-0" placeholder="Ej: 600mg cada 8 horas">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-dark">Instrucciones al paciente</label>
                                        <input type="text" class="form-control bg-white shadow-sm border-0" placeholder="Ej: Tomar con las comidas">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark">Fecha Inicio</label>
                                        <input type="date" class="form-control bg-white shadow-sm border-0" value="2026-02-25">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark">Fecha Fin</label>
                                        <input type="date" class="form-control bg-white shadow-sm border-0">
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end">
                                        <button class="btn btn-primary w-100 fw-bold shadow-sm h-100 py-2"><i class="bi bi-plus-lg me-2"></i>Añadir Receta</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="historial" role="tabpanel">
                            <h6 class="fw-bold text-dark mb-4 border-bottom pb-2">Visitas Anteriores</h6>

                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0 py-3 border-bottom border-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>15 Dic 2025 - Cardiología</span>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill">Dra. Ana Pérez</span>
                                    </div>
                                    <div class="p-3 bg-light rounded-3 mt-2">
                                        <p class="small text-dark mb-0 fst-italic">"Revisión rutinaria. ECG normal. Se recomienda control de peso y dieta baja en sal."</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script simple para cambiar el estilo de las pestañas al hacer clic
        document.addEventListener('DOMContentLoaded', function () {
            var tabs = document.querySelectorAll('#medicalTabs .nav-link');
            tabs.forEach(function(tab) {
                tab.addEventListener('click', function() {
                    tabs.forEach(t => {
                        t.classList.remove('border-primary', 'text-dark');
                        t.classList.add('border-transparent', 'text-secondary');
                    });
                    this.classList.remove('border-transparent', 'text-secondary');
                    this.classList.add('border-primary', 'text-dark');
                });
            });
        });
    </script>
}