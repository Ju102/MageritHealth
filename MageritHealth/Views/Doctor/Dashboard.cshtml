@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Panel Médico";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Bienvenido/a, Dr. @Context.User.Identity.Name</h3>
            <p class="text-muted">Especialidad: <span class="badge bg-info text-dark">Cardiología</span> | Colegiado: COL-28001</p>
        </div>
        <div class="d-flex gap-2">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Buscar paciente por DNI...">
                <button class="btn btn-primary"><i class="bi bi-search"></i></button>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="doctor-stat-card shadow-sm border-start border-primary border-4">
                <h6 class="text-muted small fw-bold">CITAS HOY</h6>
                <div class="d-flex align-items-center">
                    <span class="fs-2 fw-bold">8</span>
                    <span class="ms-auto p-2 bg-primary bg-opacity-10 text-primary rounded"><i class="bi bi-calendar-check fs-4"></i></span>
                </div>
                <p class="small text-success mb-0 mt-2"><i class="bi bi-clock"></i> Siguiente: 10:30 AM</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="doctor-stat-card shadow-sm border-start border-info border-4">
                <h6 class="text-muted small fw-bold">PACIENTES ASIGNADOS</h6>
                <div class="d-flex align-items-center">
                    <span class="fs-2 fw-bold">142</span>
                    <span class="ms-auto p-2 bg-info bg-opacity-10 text-info rounded"><i class="bi bi-person-heart fs-4"></i></span>
                </div>
                <p class="small text-muted mb-0 mt-2">+3 nuevas asignaciones este mes</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="doctor-stat-card shadow-sm border-start border-warning border-4">
                <h6 class="text-muted small fw-bold">ANALÍTICAS PENDIENTES</h6>
                <div class="d-flex align-items-center">
                    <span class="fs-2 fw-bold">5</span>
                    <span class="ms-auto p-2 bg-warning bg-opacity-10 text-warning rounded"><i class="bi bi-clipboard2-pulse fs-4"></i></span>
                </div>
                <p class="small text-danger mb-0 mt-2">2 requieren revisión urgente</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="doctor-stat-card shadow-sm border-start border-success border-4">
                <h6 class="text-muted small fw-bold">PRESCRIPCIONES</h6>
                <div class="d-flex align-items-center">
                    <span class="fs-2 fw-bold">12</span>
                    <span class="ms-auto p-2 bg-success bg-opacity-10 text-success rounded"><i class="bi bi-prescription2 fs-4"></i></span>
                </div>
                <p class="small text-muted mb-0 mt-2">Emitidas en las últimas 24h</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-clock-history me-2"></i>Agenda de Hoy - @DateTime.Now.ToString("dd MMM yyyy")</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-muted">
                                    <th class="ps-4">HORA</th>
                                    <th>PACIENTE</th>
                                    <th>MOTIVO</th>
                                    <th>ESTADO</th>
                                    <th class="text-end pe-4">ACCIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4 fw-bold">10:00</td>
                                    <td>
                                        <div class="fw-bold">Mario García Pérez</div>
                                        <span class="small text-muted">DNI: 55555555E</span>
                                    </td>
                                    <td>Revisión Anual</td>
                                    <td><span class="badge rounded-pill bg-success">Completada</span></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-medical"></i></button>
                                    </td>
                                </tr>
                                <tr class="table-primary border-primary">
                                    <td class="ps-4 fw-bold">10:30</td>
                                    <td>
                                        <div class="fw-bold">Lucía Jiménez Soto</div>
                                        <span class="small text-muted">DNI: 66666666F</span>
                                    </td>
                                    <td>Control de Marcapasos</td>
                                    <td><span class="badge rounded-pill bg-primary">En espera</span></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-primary">Iniciar Consulta</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-4 fw-bold">11:00</td>
                                    <td>
                                        <div class="fw-bold">Mario García Ramos</div>
                                        <span class="small text-muted">DNI: 77777777G</span>
                                    </td>
                                    <td>Consulta General</td>
                                    <td><span class="badge rounded-pill bg-light text-dark border">Programada</span></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white text-center py-3">
                    <a href="#" class="text-decoration-none small fw-bold">Ver agenda completa</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Alertas de Analíticas</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 border-bottom pb-2">
                        <div class="p-2 bg-danger bg-opacity-10 text-danger rounded me-3">
                            <i class="bi bi-droplet-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">Mario García (Glucosa)</div>
                            <p class="small text-muted mb-0">Valor: 230 mg/dL (Alto)</p>
                            <a href="#" class="small text-decoration-none">Ver Informe</a>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <div class="p-2 bg-warning bg-opacity-10 text-warning rounded me-3">
                            <i class="bi bi-activity"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">Lucía Jiménez (Colesterol)</div>
                            <p class="small text-muted mb-0">Valor: 210 mg/dL (Límite)</p>
                            <a href="#" class="small text-decoration-none">Ver Informe</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-person-check me-2"></i>Últimos Pacientes Asignados</h6>
                </div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex align-items-center border-0 py-3">
                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; font-weight: bold;">RG</div>
                        <div class="small">
                            <div class="fw-bold">Roberto Gómez</div>
                            <div class="text-muted">Asignado hoy</div>
                        </div>
                    </div>
                    <div class="list-group-item d-flex align-items-center border-0 py-3">
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; font-weight: bold;">AS</div>
                        <div class="small">
                            <div class="fw-bold">Ana Sanz</div>
                            <div class="text-muted">Asignada ayer</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white text-center py-2">
                    <a href="#" class="small text-decoration-none">Ver mi lista completa</a>
                </div>
            </div>
        </div>
    </div>
</div>