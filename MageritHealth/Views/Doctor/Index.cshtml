@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Panel Médico";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold mb-0">Resumen del Día</h3>
        <p class="text-muted mb-0"><i class="bi bi-calendar3 me-2"></i>Miércoles, 25 Feb 2026</p>
    </div>

    <div class="text-end" style="min-width: 280px;">
        <div class="d-flex justify-content-between small fw-bold text-muted mb-1">
            <span>Progreso del turno</span>
            <span class="text-primary">3 de 8 pacientes (37%)</span>
        </div>
        <div class="progress shadow-sm" style="height: 10px; background-color: #e9ecef;">
            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: 37%"></div>
        </div>
        <div class="small text-muted mt-2 text-start d-flex justify-content-between">
            <span><i class="bi bi-clock-history me-1"></i> Tiempo medio/visita: <strong class="text-dark">18 min</strong></span>
            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> En hora</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="doctor-stat-card border-primary">
            <div>
                <div class="text-muted small fw-bold">CITAS HOY</div>
                <div class="fs-3 fw-bold">8</div>
            </div>
            <i class="bi bi-people-fill icon-wrapper"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="doctor-stat-card border-success">
            <div>
                <div class="text-muted small fw-bold">ATENDIDOS</div>
                <div class="fs-3 fw-bold">3</div>
            </div>
            <i class="bi bi-check-circle-fill icon-wrapper"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="doctor-stat-card border-warning">
            <div>
                <div class="text-muted small fw-bold">EN SALA DE ESPERA</div>
                <div class="fs-3 fw-bold text-warning">1</div>
            </div>
            <i class="bi bi-clock-fill icon-wrapper"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="doctor-stat-card border-danger">
            <div>
                <div class="text-muted small fw-bold">RESULTADOS PENDIENTES</div>
                <div class="fs-3 fw-bold">2</div>
            </div>
            <i class="bi bi-file-medical-fill icon-wrapper"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0"><i class="bi bi-list-task me-2"></i>Agenda de Pacientes</h6>
                <div class="btn-group">
                    <button class="btn btn-sm btn-primary">Hoy</button>
                    <button class="btn btn-sm btn-outline-primary">Mañana</button>
                </div>
            </div>
            <div class="card-body p-0 mt-3">
                <div class="table-responsive">
                    <table class="table table-agenda w-100 mb-0">
                        <thead>
                            <tr>
                                <th style="width: 10%">Hora</th>
                                <th style="width: 25%">Paciente</th>
                                <th style="width: 15%">DNI / ID</th>
                                <th style="width: 25%">Motivo de Consulta</th>
                                <th style="width: 12%">Estado</th>
                                <th style="width: 13%" class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-muted">09:30</td>
                                <td>
                                    <div class="fw-bold">Juan Torres Ramírez</div>
                                    <div class="small text-muted">20 años (V)</div>
                                </td>
                                <td>55555555E</td>
                                <td>Fiebre y tos</td>
                                <td><span class="status-badge status-completed">Completada</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-table-action" title="Ver resumen">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>

                            <tr style="background-color: #fdfbf7; border-left: 3px solid var(--clinic-primary);">
                                <td class="fw-bold text-primary">10:00</td>
                                <td>
                                    <div class="fw-bold text-primary">María Díaz Martín</div>
                                    <div class="small text-muted">31 años (M)</div>
                                </td>
                                <td>44444444D</td>
                                <td>Revisión de analítica</td>
                                <td><span class="status-badge status-ongoing">En Consulta</span></td>
                                <td class="text-end">
                                    <a class="btn btn-primary btn-table-action shadow-sm fw-bold" asp-action="Consulta" asp-controller="Doctor">
                                        <i class="bi bi-folder2-open me-1"></i> Abrir Ficha
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td class="fw-bold text-dark">11:00</td>
                                <td>
                                    <div class="fw-bold">Carlos Sánchez Ruiz</div>
                                    <div class="small text-muted">45 años (V)</div>
                                </td>
                                <td>88888888X</td>
                                <td>Renovación de recetas crónicas</td>
                                <td><span class="status-badge status-scheduled">Programada</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-table-action">
                                        <i class="bi bi-folder2-open me-1"></i> Preparar
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td class="fw-bold text-muted text-decoration-line-through">12:30</td>
                                <td class="text-muted">
                                    <div class="fw-bold">Elena Gómez Salas</div>
                                </td>
                                <td class="text-muted">11223344Z</td>
                                <td class="text-muted">Dolor de cabeza</td>
                                <td><span class="status-badge status-cancelled">Cancelada</span></td>
                                <td class="text-end">
                                    <span class="small text-muted">Por paciente</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">

        <div class="card border-0 shadow-sm mb-4" style="background-color: #fffde7; border-left: 4px solid #fbc02d !important;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0 text-dark"><i class="bi bi-journal-text text-warning me-2"></i>Mis Notas</h6>
                    <button class="btn btn-sm text-muted p-0"><i class="bi bi-plus-lg"></i></button>
                </div>
                <ul class="list-unstyled mb-0 small text-dark">
                    <li class="mb-2 pb-2 border-bottom border-warning border-opacity-25 d-flex align-items-start">
                        <input class="form-check-input me-2 mt-1" type="checkbox" value="" aria-label="...">
                        <span>Llamar a Farmacia central por el stock de Lorazepam.</span>
                    </li>
                    <li class="mb-2 pb-2 border-bottom border-warning border-opacity-25 d-flex align-items-start">
                        <input class="form-check-input me-2 mt-1" type="checkbox" value="" aria-label="...">
                        <span>Revisar bibliografía caso clínico paciente cama 302.</span>
                    </li>
                    <li class="d-flex align-items-start text-muted text-decoration-line-through">
                        <input class="form-check-input me-2 mt-1" type="checkbox" value="" checked aria-label="...">
                        <span>Firmar volantes pendientes de ayer.</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white pt-3 pb-2 border-bottom">
                <h6 class="fw-bold m-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Alertas Clínicas</h6>
            </div>
            <div class="card-body p-3">
                <div class="border-bottom pb-2 mb-2">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold small">Analítica Alterada</span>
                        <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">URGENTE</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.8rem;">Paciente: Roberto Díaz. Colesterol LDL > 190.</div>
                    <a href="#" class="small text-decoration-none mt-1 d-inline-block">Revisar resultados</a>
                </div>
                <div>
                    <div class="fw-bold small">Petición de Receta</div>
                    <div class="text-muted" style="font-size: 0.8rem;">Paciente: Sofía Castro. Ibuprofeno 600mg.</div>
                    <a href="#" class="small text-decoration-none mt-1 d-inline-block">Autorizar</a>
                </div>
            </div>
        </div>
    </div>
</div>