@using MageritHealth.Models
@model List<Cita>

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Mis Citas Médicas";

    // Filtramos las citas para mejorar la experiencia de usuario
    var citasProximas = Model.Where(c => c.Estado.ToLower() == "programada")
                             .OrderBy(c => c.FechaHora).ToList();

    var historialCitas = Model.Where(c => c.Estado.ToLower() != "programada")
                              .OrderByDescending(c => c.FechaHora).ToList();
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Mis Citas Médicas</h3>
            <p class="text-muted small">Gestiona tus próximas visitas y consulta tu historial clínico.</p>
        </div>
        <a asp-controller="Paciente" asp-action="SolicitarCita" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm" style="background-color: #0ea5e9; border-color: #0ea5e9;">
            <i class="bi bi-calendar-plus me-2"></i>Nueva Cita
        </a>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-calendar-event text-primary me-2"></i>Próximas Visitas
            </h5>

            @if (citasProximas.Any())
            {
                <div class="row g-3">
                    @foreach (var cita in citasProximas)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="patient-card p-4 border-start border-info border-5 shadow-sm h-100 position-relative">
                                <div class="position-absolute top-0 end-0 p-3">
                                    <button class="btn btn-sm btn-outline-danger border-0" title="Cancelar Cita">
                                        <i class="bi bi-x-circle fs-5"></i>
                                    </button>
                                </div>

                                <div class="d-flex align-items-center mb-3">
                                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 text-center me-3">
                                        <div class="fs-4 fw-bold lh-1">@cita.FechaHora.ToString("dd")</div>
                                        <div class="small fw-semibold text-uppercase">@cita.FechaHora.ToString("MMM")</div>
                                        <div class="small fw-semibold text-uppercase">@cita.FechaHora.ToString("yyyy")</div>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 text-dark">@cita.FechaHora.ToString("HH:mm") h</h6>
                                        <span class="badge bg-warning text-dark bg-opacity-25 border border-warning rounded-pill">Programada</span>
                                    </div>
                                </div>

                                <h6 class="fw-bold text-dark text-truncate" title="@cita.Motivo">@cita.Motivo</h6>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-person-badge me-2"></i>Dr./a. @cita.Doctor.Nombre @cita.Doctor.Apellido1
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="patient-card p-4 text-center bg-light border-0 shadow-sm">
                    <i class="bi bi-calendar-check text-muted fs-1 mb-2 d-block opacity-50"></i>
                    <h6 class="fw-bold text-secondary">No tienes citas próximas</h6>
                    <p class="text-muted small mb-0">Tus próximas visitas médicas aparecerán aquí.</p>
                </div>
            }
        </div>

        <div class="col-12 mt-5">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-clock-history text-secondary me-2"></i>Historial de Consultas
            </h5>

            <div class="patient-card shadow-sm overflow-hidden border-0">
                @if (historialCitas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small text-muted">
                                <tr>
                                    <th class="ps-4">FECHA Y HORA</th>
                                    <th>ESPECIALISTA</th>
                                    <th>MOTIVO</th>
                                    <th>ESTADO</th>
                                    <th class="text-end pe-4">INFORME</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in historialCitas)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">
                                            @cita.FechaHora.ToString("dd MMM yyyy - HH:mm")
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">Dr./a. @cita.Doctor.Nombre @cita.Doctor.Apellido1</div>
                                            <div class="small text-muted">@cita.Doctor.Especialidad?.NombreEspecialidad</div>
                                        </td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@cita.Motivo">
                                            @cita.Motivo
                                        </td>
                                        <td>
                                            @if (cita.Estado.ToLower() == "completada")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success">Completada</span>
                                            }
                                            else if (cita.Estado.ToLower() == "cancelada")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">@cita.Estado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (cita.Estado.ToLower() == "completada")
                                            {
                                                <button class="btn btn-sm btn-outline-primary" title="Ver Detalles">
                                                    <i class="bi bi-file-earmark-medical"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-folder2-open fs-1 opacity-50 d-block mb-2"></i>
                        Aún no tienes historial médico registrado.
                    </div>
                }
            </div>
        </div>
    </div>
</div>