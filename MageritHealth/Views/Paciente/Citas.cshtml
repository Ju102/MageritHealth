@using MageritHealth.Models
@model List<Cita>

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Mis Citas Médicas";

    var citasProximas = Model.Where(c => c.Estado.ToLower() == "programada")
                             .OrderBy(c => c.FechaHora).ToList();

    var historialCitas = Model.Where(c => c.Estado.ToLower() != "programada")
                              .OrderByDescending(c => c.FechaHora).ToList();
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Mis Citas Médicas</h3>
            <p class="text-muted small">Gestiona tus consultas y revisa diagnósticos pasados.</p>
        </div>
        <a asp-controller="Paciente" asp-action="SolicitarCita" class="btn btn-outline-primary btn-lg rounded-3 fw-bold shadow-sm d-none d-md-inline-block">
            <i class="bi bi-calendar-plus me-2"></i>Solicitar Cita
        </a>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-calendar-event text-primary me-2"></i>Próximas Visitas
            </h5>

            @if (citasProximas.Any())
            {
                <div class="row g-4">
                    @foreach (var cita in citasProximas)
                    {
                        <div class="col-lg-6">
                            <div class="patient-card p-4 h-100 border-start border-info border-5 shadow-sm position-relative d-flex flex-column">
                                <div class="position-absolute top-0 end-0 p-3">
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill small">Programada</span>
                                </div>

                                <div class="d-flex align-items-center mb-3 mt-4 mt-sm-0">
                                    <div class="me-3 text-center border-end pe-3">
                                        <h2 class="fw-bold text-info mb-0">@cita.FechaHora.ToString("dd")</h2>
                                        <span class="text-muted small text-uppercase fw-bold">@cita.FechaHora.ToString("MMM")</span>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1 text-truncate" style="max-width: 200px;" title="@cita.Motivo">@cita.Motivo</h5>
                                        <small class="text-muted fw-bold"><i class="bi bi-clock me-1"></i> @cita.FechaHora.ToString("HH:mm") h</small>
                                    </div>
                                </div>

                                <div class="bg-light p-3 rounded-3 border mb-4 flex-grow-1">
                                    <p class="mb-0 fw-bold text-dark"><i class="bi bi-person-badge text-primary me-2"></i>Especialista:</p>
                                    <p class="mb-1 text-muted ms-4">Dr./a. @cita.Doctor.Nombre @cita.Doctor.Apellido1</p>
                                </div>

                                <div class="text-end mt-auto">
                                    <a asp-controller="Paciente" asp-action="DetallesCita" asp-route-idcita="@cita.IdCita" class="btn btn-sm btn-light text-primary fw-bold shadow-sm">
                                        <i class="bi bi-file-earmark-medical me-1"></i>Informe
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="patient-card p-5 border-start border-secondary border-5 shadow-sm text-center bg-light bg-opacity-50">
                    <i class="bi bi-calendar-x fs-1 text-muted opacity-50 mb-2 d-block"></i>
                    <h6 class="fw-bold text-secondary mb-1">Agenda libre</h6>
                    <p class="text-muted small mb-0">No tienes visitas programadas próximamente.</p>
                </div>
            }
        </div>

        <div class="col-12 mt-5">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-clock-history text-secondary me-2"></i>Historial Clínico
            </h5>

            <div class="patient-card shadow-sm overflow-hidden border-0">
                @if (historialCitas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small text-muted">
                                <tr>
                                    <th class="ps-4">FECHA Y HORA</th>
                                    <th>ESPECIALISTA</th>
                                    <th>MOTIVO</th>
                                    <th>ESTADO</th>
                                    <th class="text-end pe-4">ACCIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in historialCitas)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark">@cita.FechaHora.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">@cita.FechaHora.ToString("HH:mm") h</div>
                                        </td>
                                        <td class="py-3">
                                            <div class="fw-bold text-dark">Dr./a. @cita.Doctor.Apellido1</div>
                                            <div class="small text-muted">@cita.Doctor.Especialidad?.NombreEspecialidad</div>
                                        </td>
                                        <td class="py-3">
                                            <span class="text-secondary text-truncate d-inline-block" style="max-width: 200px;" title="@cita.Motivo">
                                                @cita.Motivo
                                            </span>
                                        </td>
                                        <td class="py-3">
                                            @if (cita.Estado.ToLower() == "completada")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small">Completada</span>
                                            }
                                            else if (cita.Estado.ToLower() == "cancelada")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill small">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill small">@cita.Estado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4 py-3">
                                            @if (cita.Estado.ToLower() == "completada")
                                            {
                                                <a asp-controller="Paciente" asp-action="DetallesCita" asp-route-idcita="@cita.IdCita" class="btn btn-sm btn-light text-primary fw-bold shadow-sm">
                                                    <i class="bi bi-file-earmark-medical me-1"></i>Informe
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center bg-light bg-opacity-50">
                        <i class="bi bi-archive fs-1 text-muted opacity-50 mb-3 d-block"></i>
                        <p class="text-muted small mb-0">Aún no tienes historial médico registrado en el sistema.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>