@using MageritHealth.Models.ViewModels
@model PacienteDashboardViewModel

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Mi Portal de Salud";
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Hola de nuevo, @Model.Nombre</h3>
            <p class="text-muted small"><i class="bi bi-shield-check text-success me-1"></i>Nº Asegurado: <span class="fw-bold text-dark">@Model.NumeroAsegurado</span></p>
        </div>
        <a class="btn btn-outline-primary btn-lg rounded-3 fw-bold shadow-sm d-none d-md-inline-block" asp-controller="Paciente" asp-action="SolicitarCita">
            <i class="bi bi-calendar-plus me-2"></i>Solicitar Cita
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-calendar-event text-primary me-2"></i>Próxima Cita
            </h5>

            <div class="patient-card p-4 mb-5 border-start border-info border-5 shadow-sm">
                @if (Model.ProximaCita != null)
                {
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-info border border-info rounded-pill small">Programada</span>
                            </div>

                            <h4 class="fw-bold text-dark mb-1">@Model.ProximaCita.Motivo</h4>
                            <p class="text-muted mb-0">
                                <i class="bi bi-person-badge text-primary me-2"></i>Dr/a. @Model.ProximaCita.Doctor.Nombre @Model.ProximaCita.Doctor.Apellido1 @Model.ProximaCita.Doctor.Apellido2
                            </p>
                        </div>

                        <div class="col-md-4 text-md-end mt-3 mt-md-0 border-md-start ps-md-4">
                            <h2 class="fw-bold text-info mb-0">
                                @Model.ProximaCita.FechaHora.ToString("dd")
                                <span class="fs-5 text-muted fw-normal text-uppercase">@Model.ProximaCita.FechaHora.ToString("MMM")</span>
                            </h2>
                            <span class="text-muted small fw-bold">
                                <i class="bi bi-clock me-1"></i>@Model.ProximaCita.FechaHora.ToString("HH:mm") h
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="bi bi-calendar-x fs-2 text-muted opacity-50 mb-2 d-block"></i>
                        <p class="text-muted mb-0">No tienes ninguna cita programada en este momento.</p>
                    </div>
                }
            </div>

            <h5 class="fw-bold text-dark mb-3 mt-4">
                <i class="bi bi-clock-history text-secondary me-2"></i>Consultas Recientes
            </h5>

            <div class="patient-card shadow-sm overflow-hidden border-0">
                <div class="list-group list-group-flush">
                    @if (Model.UltimasTresCitas != null && Model.UltimasTresCitas.Count != 0)
                    {
                        @foreach (Cita cita in Model.UltimasTresCitas)
                        {
                            <div class="list-group-item p-4 @(cita == Model.UltimasTresCitas.Last() ? "" : "border-bottom")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill small">Completada</span>
                                    <small class="text-muted fw-bold">@cita.FechaHora.ToShortDateString()</small>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Motivo: @cita.Motivo</h6>
                                <p class="text-muted small mb-0"><i class="bi bi-person-badge me-1"></i> Dr/a. @cita.Doctor.Nombre @cita.Doctor.Apellido1 @cita.Doctor.Apellido2</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            <p class="text-muted small mb-0">Tu historial de citas está vacío.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-activity text-danger me-2"></i>Resumen Vital
            </h5>

            <div class="patient-card p-4 mb-4 border-start border-danger border-5 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Signos Básicos</h6>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="bg-light p-2 rounded-3 text-center border">
                            <small class="text-muted d-block mb-1">Sangre</small>
                            <span class="fw-bold text-danger">@Model.Perfil.TipoSangre</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-light p-2 rounded-3 text-center border">
                            <small class="text-muted d-block mb-1">Peso</small>
                            <span class="fw-bold text-dark">@Model.Perfil.Peso <span class="small fw-normal">Kg</span></span>
                        </div>
                    </div>
                </div>

                <div class="p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 d-flex align-items-center small mt-3">
                    <i class="bi bi-telephone-outbound text-danger fs-5 me-2"></i>
                    <div>
                        <span class="fw-bold text-dark d-block">Emergencia: @Model.Perfil.NombreContacto</span>
                        <span class="text-muted">@Model.Perfil.TelefonoContacto</span>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-3 mt-4">
                <i class="bi bi-capsule-pill text-success me-2"></i>Medicación
            </h5>

            <div class="patient-card p-4 border-start border-success border-5 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Tratamientos Activos</h6>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small">@Model.MedicacionActiva.Count</span>
                </div>

                @if (Model.MedicacionActiva != null && Model.MedicacionActiva.Count != 0)
                {
                    <div class="list-group list-group-flush mb-3">
                        @foreach (Prescripcion prescripcion in Model.MedicacionActiva)
                        {
                            <div class="list-group-item px-0 py-2 border-0 mb-2">
                                <div class="fw-bold text-dark mb-1">@prescripcion.Medicamento.NombreComercial <span class="text-muted fs-6 fw-normal">(@prescripcion.Medicamento.Concentracion)</span></div>
                                <div class="text-muted small"><i class="bi bi-info-circle me-1"></i>@prescripcion.Instrucciones</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">No hay medicación activa en este momento.</p>
                }
            </div>
        </div>
    </div>
</div>