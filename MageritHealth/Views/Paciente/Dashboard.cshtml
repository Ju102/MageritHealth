@using MageritHealth.Models.ViewModels
@model PacienteDashboardViewModel

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Mi Portal de Salud";
}

<div class="container">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark mb-1">Hola de nuevo, @Model.Nombre.</h2>
            <p class="text-muted">Nº Asegurado: <span class="fw-bold">@Model.NumeroAsegurado</span></p>
        </div>
        <div class="col-md-4 text-md-end">
            <a class="btn btn-request btn-lg shadow-sm px-4" asp-controller="Paciente" asp-action="SolicitarCita">
                <i class="bi bi-plus-circle me-2"></i>Solicitar Nueva Cita
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="patient-card p-4 mb-4 border-start border-info border-5">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6 class="text-info fw-bold small text-uppercase">Tu próxima cita</h6>
                        @if (Model.ProximaCita != null)
                        {
                            <h3 class="fw-bold mb-1">@Model.ProximaCita.Motivo</h3>
                            <p class="text-muted mb-0"><i class="bi bi-person-badge me-2"></i>Dr./a. @Model.ProximaCita.Doctor.Nombre @Model.ProximaCita.Doctor.Apellido2</p>
                        } else
                        {
                            <p class="text-secondary mt-3">No tienes ninguna cita programada.</p>    
                        }
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        @if (Model.ProximaCita != null)
                        {
                            <div class="p-3 bg-info bg-opacity-10 rounded-4 d-inline-block text-center">
                                <div class="fs-4 fw-bold text-info text-uppercase">@Model.ProximaCita.FechaHora.ToString("dd") @Model.ProximaCita.FechaHora.ToString("MMM")</div>
                                <div class="small text-info fw-semibold">@Model.ProximaCita.FechaHora.ToString("hh:mm")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="patient-card overflow-hidden">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Historial Reciente de Consultas</h6>
                    <a href="#" class="text-decoration-none small">Ver todo</a>
                </div>
                @if (Model.UltimasTresCitas != null && Model.UltimasTresCitas.Count != 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small">
                                <tr>
                                    <th class="ps-4">FECHA</th>
                                    <th>DOCTOR</th>
                                    <th>MOTIVO</th>
                                    <th class="text-end pe-4">DETALLES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (Cita cita in Model.UltimasTresCitas)
                                {
                                    <tr>
                                        <td class="ps-4">@cita.FechaHora.ToShortDateString()</td>
                                        <td>Dr./a. @cita.Doctor.Nombre @cita.Doctor.Apellido1</td>
                                        <td>@cita.Motivo</td>
                                        <td class="text-end pe-4">
                                            <a class="btn btn-sm btn-outline-light text-primary border"><i class="bi bi-file-text"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                } else
                {
                    <p class="text-center text-secondary mt-4 mb-4">Tu historial de citas está vacío.</p>
                }
            </div>
        </div>

        <div class="col-lg-4">

            <div class="patient-card p-4 mb-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-clipboard-pulse text-danger me-2"></i>Perfil Vital</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block">Sangre</small>
                            <span class="fw-bold fs-5">@Model.Perfil.TipoSangre</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted d-block">Peso</small>
                            <span class="fw-bold fs-5">@Model.Perfil.Peso Kg</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 p-2 border rounded-3 small">
                    <i class="bi bi-telephone-outbound text-primary me-2"></i>
                    <b>Emergencia:</b> @Model.Perfil.NombreContacto (@Model.Perfil.TelefonoContacto)
                </div>
            </div>

            <div class="patient-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-capsule-pill text-success me-2"></i>Mi Medicación</h6>
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.MedicacionActiva.Count activa/s</span>
                </div>
                @if (Model.MedicacionActiva != null && Model.MedicacionActiva.Count != 0)
                {
                    @foreach (Prescripcion prescripcion in Model.MedicacionActiva)
                    {
                        <div class="d-flex align-items-center p-2">
                            <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-circle me-3">
                                <i class="bi bi-pills"></i>
                            </div>
                            <div class="small">
                                <div class="fw-bold">@prescripcion.Medicamento.NombreComercial @prescripcion.Medicamento.Concentracion</div>
                                <div class="text-muted">@prescripcion.Instrucciones</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-secondary">No hay medicación activa</p>
                }
                <a href="#" class="btn btn-light w-100 mt-3 btn-sm fw-bold">Ver Plan de Medicación</a>
            </div>
        </div>
    </div>
</div>