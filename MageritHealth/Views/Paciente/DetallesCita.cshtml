@using MageritHealth.Models
@model Cita

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Detalles de la Cita";

    string borderClass = "border-info";
    string textClass = "text-info";
    string badgeClass = "bg-info text-dark bg-opacity-25 border-info";
    string iconClass = "bi-calendar-event";

    if (Model.Estado.ToLower() == "completada")
    {
        borderClass = "border-success";
        textClass = "text-success";
        badgeClass = "bg-success bg-opacity-10 text-success border-success";
        iconClass = "bi-check-circle-fill";
    }
    else if (Model.Estado.ToLower() == "cancelada")
    {
        borderClass = "border-danger";
        textClass = "text-danger";
        badgeClass = "bg-danger bg-opacity-10 text-danger border-danger";
        iconClass = "bi-x-circle-fill";
    }
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Detalles de la Consulta</h3>
            <p class="text-muted small">Información completa sobre tu cita médica.</p>
        </div>
        <div>
            <a asp-controller="Paciente" asp-action="Citas" class="btn btn-outline-secondary rounded-3 fw-bold shadow-sm me-2">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <div class="row justify-content-center g-4">

        <div class="col-lg-8">

            <div class="patient-card p-4 mb-4 border-start @borderClass border-5 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi @iconClass @textClass fs-3 me-3"></i>
                        <h5 class="fw-bold text-dark mb-0">Estado Actual</h5>
                    </div>
                    <span class="badge @badgeClass border rounded-pill px-3 py-2 text-uppercase fw-bold">
                        @Model.Estado
                    </span>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-8">
                        <small class="text-muted fw-bold text-uppercase">Fecha y Hora Agendada</small>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.FechaHora.ToString("dd MMMM yyyy")</h3>
                        <p class="fs-5 @textClass fw-semibold mb-0">A las @Model.FechaHora.ToString("HH:mm") horas</p>
                    </div>
                </div>
            </div>

            <div class="patient-card p-4 shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="bi bi-journal-medical text-primary me-2"></i>Información Clínica
                </h5>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted small text-uppercase mb-2">Motivo de la Visita</h6>
                    <div class="p-3 bg-light rounded-3 border border-light">
                        <p class="mb-0 text-dark fw-medium">@Model.Motivo</p>
                    </div>
                </div>

                @if (Model.Estado.ToLower() == "completada")
                {
                    <div class="mb-4">
                        <h6 class="fw-bold text-muted small text-uppercase mb-2">Conclusión y Notas del Doctor</h6>
                        @if (!string.IsNullOrEmpty(Model.Notas))
                        {
                            <div class="p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3">
                                <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.Notas</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light text-muted rounded-3 text-center border">
                                <em>El doctor no ha añadido notas adicionales a esta consulta.</em>
                            </div>
                        }
                    </div>

                    @if (Model.Prescripciones != null && Model.Prescripciones.Any())
                    {
                        <div class="mb-2">
                            <h6 class="fw-bold text-success small text-uppercase mb-2 d-flex justify-content-between align-items-end">
                                <span><i class="bi bi-capsule-pill me-1"></i> Medicación Recetada</span>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill">@Model.Prescripciones.Count medicamento/s</span>
                            </h6>

                            <div class="p-4 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 mb-3">
                                <div class="list-group list-group-flush bg-transparent">
                                    @foreach (var prescripcion in Model.Prescripciones)
                                    {
                                        <div class="list-group-item bg-transparent border-success border-opacity-25 px-0 py-2 d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-bold text-dark">@prescripcion.Medicamento.NombreComercial <span class="text-muted fw-normal fs-6">(@prescripcion.Medicamento.Concentracion)</span></div>
                                                <div class="small text-muted fst-italic">@prescripcion.Instrucciones</div>
                                            </div>
                                            <div class="text-end small">
                                                <span class="text-dark fw-bold d-block">Hasta el @prescripcion.FechaFin.ToString("dd/MM")</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (Model.Estado.ToLower() == "programada")
                {
                    <div class="alert bg-warning bg-opacity-10 border-warning border-opacity-25 text-dark rounded-3 d-flex align-items-center mb-0">
                        <i class="bi bi-info-circle-fill text-warning fs-4 me-3"></i>
                        <div>
                            <strong>Consulta Pendiente:</strong> Las notas e indicaciones del médico aparecerán aquí una vez finalizada la cita.
                        </div>
                    </div>
                }
            </div>

        </div>

        <div class="col-lg-4">

            <div class="patient-card p-4 mb-4 shadow-sm">
                <h6 class="fw-bold text-dark mb-3">Especialista Asignado</h6>

                <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">Dr/a. @Model.Doctor.Nombre @Model.Doctor.Apellido1</div>
                        @if (Model.Doctor.Especialidad != null)
                        {
                            <div class="text-primary small fw-bold">@Model.Doctor.Especialidad.NombreEspecialidad</div>
                        }
                        <div class="text-muted small mt-1">Col: @Model.Doctor.NumeroColegiado</div>
                    </div>
                </div>
            </div>

            <div class="patient-card p-4 shadow-sm bg-light border-0">
                <h6 class="fw-bold text-dark mb-3">Gestión de la Cita</h6>

                @if (Model.Estado.ToLower() == "programada")
                {
                    <p class="small text-muted mb-3">
                        Si no puedes asistir a tu cita, por favor cancélala con antelación para que otro paciente pueda ocupar tu lugar.
                    </p>
                    <button class="btn btn-outline-danger w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#cancelarModal">
                        <i class="bi bi-x-circle me-2"></i>Cancelar Cita
                    </button>
                    <p class="text-center text-muted small mt-3 mb-0">
                        <i class="bi bi-clock me-1"></i> Creada el @Model.FechaCreacion.ToString("dd/MM/yy")
                    </p>
                }
                else if (Model.Estado.ToLower() == "completada")
                {
                    <p class="small text-muted mb-3">
                        Puedes descargar el informe oficial de esta consulta y tu receta médica (si aplica).
                    </p>

                    <div class="d-grid gap-2">
                        <a asp-controller="Paciente" asp-action="DetallesCitaPdf" asp-route-id="@Model.IdCita" class="btn btn-primary fw-bold shadow-sm">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Informe Médico
                        </a>

                        @if (Model.Prescripciones != null && Model.Prescripciones.Any())
                        {
                            <a asp-controller="Paciente" asp-action="DetallesRecetaPdf" asp-route-id="@Model.IdCita" class="btn btn-success fw-bold shadow-sm">
                                <i class="bi bi-prescription2 me-2"></i>Descargar Receta
                            </a>
                        }
                    </div>
                }
                else if (Model.Estado.ToLower() == "cancelada")
                {
                    <div class="text-center p-3 border border-danger border-opacity-25 rounded-3 bg-white">
                        <i class="bi bi-calendar-x text-danger fs-1 mb-2"></i>
                        <p class="mb-0 text-danger fw-bold small">Esta cita fue cancelada y ya no está vigente.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@if (Model.Estado.ToLower() == "programada")
{
    <div class="modal fade" id="cancelarModal" tabindex="-1" aria-labelledby="cancelarModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-danger bg-opacity-10 border-0">
                    <h5 class="modal-title fw-bold text-danger" id="cancelarModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>¿Cancelar Cita?
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark">Estás a punto de cancelar tu cita de <strong>@Model.Motivo</strong> para el <strong>@Model.FechaHora.ToString("dd/MM/yyyy")</strong>.</p>
                    <p class="small text-muted mb-0">Esta acción no se puede deshacer. Si cancelas, tendrás que solicitar una nueva cita sujeta a la disponibilidad de agenda del especialista.</p>
                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Mantener Cita</button>

                    <form asp-controller="Paciente" asp-action="CancelarCita" method="post">
                        <input type="hidden" name="idcita" value="@Model.IdCita" />
                        <button type="submit" class="btn btn-danger fw-bold shadow-sm">Sí, Cancelar Cita</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}