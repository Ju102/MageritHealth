@using MageritHealth.Models.ViewModels
@model EditPacienteViewModel

@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Editar Mi Perfil";
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Configuración de Perfil</h3>
            <p class="text-muted small">Actualiza tus datos de contacto y credenciales de acceso.</p>
        </div>
        <a asp-controller="Paciente" asp-action="Perfil" class="btn btn-outline-secondary rounded-3 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Cancelar
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-controller="Paciente" asp-action="EditarPerfil" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="patient-card shadow-sm overflow-hidden mb-4 border-start border-primary border-5">
                    <div class="p-4 bg-light border-bottom">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="bi bi-person-lines-fill me-2"></i>Datos de Contacto
                        </h6>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label small fw-bold text-muted">Número de Teléfono</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                                    <input asp-for="Telefono" class="form-control border-start-0 ps-0" placeholder="Ej: 600123456" />
                                </div>
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label small fw-bold text-muted">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="usuario@correo.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                                <div class="form-text small">Se usará para iniciar sesión y enviarte notificaciones.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="patient-card shadow-sm overflow-hidden mb-4 border-start border-warning border-5">
                    <div class="p-4 bg-light border-bottom">
                        <h6 class="fw-bold text-warning text-darken mb-0">
                            <i class="bi bi-shield-lock-fill me-2"></i>Seguridad y Acceso
                        </h6>
                    </div>

                    <div class="card-body p-4">
                        <div class="alert bg-warning bg-opacity-10 text-dark border-warning border-opacity-25 rounded-3 small mb-4">
                            <i class="bi bi-info-circle-fill text-warning me-2"></i>
                            <strong>Atención:</strong> Si no deseas cambiar tu contraseña actual, deja estos campos en blanco.
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label small fw-bold text-muted">Nueva Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-key text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Confirmar Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-2">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm fw-bold">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}