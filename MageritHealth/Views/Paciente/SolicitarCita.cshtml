@using MageritHealth.Models.ViewModels
@model SolicitarCitaViewModel
@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Solicitar Cita";
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Programa tu Visita</h3>
            <p class="text-muted small">Sigue estos pasos para asegurar tu espacio con nuestros especialistas.</p>
        </div>
        <a asp-controller="Paciente" asp-action="Dashboard" class="btn btn-outline-secondary rounded-3 fw-bold shadow-sm d-none d-md-inline-block">
            Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-controller="Paciente" asp-action="SolicitarCita" method="post" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 shadow-sm border-danger border-opacity-25" role="alert"></div>

                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-1-circle-fill text-primary me-2"></i>Especialidad y Médico
                </h5>

                <div class="patient-card p-4 mb-4 border-start border-primary border-5 shadow-sm position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdEspecialidad" class="form-label fw-bold text-dark small">Especialidad Requerida</label>
                            <select asp-for="IdEspecialidad" asp-items="ViewBag.Especialidades" class="form-select bg-light" id="selectEspecialidad">
                                <option selected value="">Selecciona...</option>
                            </select>
                            <span asp-validation-for="IdEspecialidad" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdDoctor" class="form-label fw-bold text-dark small">Facultativo</label>
                            <select asp-for="IdDoctor" class="form-select bg-light" id="selectDoctor" disabled>
                                <option selected value="">Espera especialidad...</option>
                            </select>
                            <span asp-validation-for="IdDoctor" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-3 mt-4">
                    <i class="bi bi-2-circle-fill text-info me-2"></i>Fecha y Hora
                </h5>

                <div class="patient-card p-4 mb-4 border-start border-info border-5 shadow-sm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label fw-bold text-dark small">Día de la Consulta</label>
                            <input asp-for="Fecha" type="date" class="form-control bg-light" min="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <span asp-validation-for="Fecha" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Hora" class="form-label fw-bold text-dark small">Tramo Horario</label>
                            <select asp-for="Hora" class="form-select bg-light" id="selectHora" disabled>
                                <option selected value="">Elige médico y fecha...</option>
                            </select>
                            <span asp-validation-for="Hora" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-3 mt-4">
                    <i class="bi bi-3-circle-fill text-success me-2"></i>Detalles Adicionales
                </h5>

                <div class="patient-card p-4 border-start border-success border-5 shadow-sm mb-4">
                    <label asp-for="Motivo" class="form-label fw-bold text-dark small">Breve descripción del motivo</label>
                    <textarea asp-for="Motivo" class="form-control bg-light" rows="3" placeholder="Síntomas, revisión rutinaria, etc."></textarea>
                    <span asp-validation-for="Motivo" class="text-danger small mt-1 d-block"></span>

                    <div class="mt-3 p-2 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2 ms-1"></i>
                        <small class="text-dark">Si es una emergencia vital, por favor llama al <strong>112</strong> o acude a urgencias inmediatamente.</small>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Paciente" asp-action="Dashboard" class="btn btn-light fw-bold text-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                        Confirmar Reserva <i class="bi bi-calendar-check ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $("#selectEspecialidad").change(function () {
                var especialidadId = $(this).val();
                var selectDoctor = $("#selectDoctor");

                selectDoctor.empty();

                if (especialidadId) {
                    selectDoctor.prop("disabled", false);
                    selectDoctor.append('<option value="">Cargando médicos...</option>');

                    $.getJSON('@Url.Action("GetDoctoresPorEspecialidad", "Paciente")', { idEspecialidad: especialidadId }, function (data) {
                        selectDoctor.empty();
                        selectDoctor.append('<option value="">-- Selecciona Médico --</option>');

                        $.each(data, function (index, item) {
                            selectDoctor.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                    });
                } else {
                    selectDoctor.prop("disabled", true);
                    selectDoctor.append('<option value="">Espera especialidad...</option>');
                }
            });

            function cargarHorasDisponibles() {
            var doctorId = $("#selectDoctor").val();
            var fechaSeleccionada = $("#Fecha").val();
            var selectHora = $("#selectHora");

            if (doctorId && fechaSeleccionada) {

                selectHora.prop("disabled", false);
                selectHora.empty();
                selectHora.append('<option value="">Buscando huecos libres...</option>');

                $.getJSON('@Url.Action("GetHorasDisponibles", "Paciente")', { idDoctor: doctorId, fecha: fechaSeleccionada }, function (data) {

                    selectHora.empty();

                    if (data.length > 0) {
                        selectHora.append('<option value="">-- Selecciona hora --</option>');
                        $.each(data, function (index, item) {
                            selectHora.append('<option value="' + item + '">' + item + '</option>');
                        });
                    } else {
                        selectHora.append('<option value="">No hay citas disponibles este día</option>');
                        selectHora.prop("disabled", true);
                    }
                });
            } else {
                selectHora.empty();
                selectHora.append('<option value="">Elige médico y fecha...</option>');
                selectHora.prop("disabled", true);
            }
        }

        $("#selectDoctor").change(cargarHorasDisponibles);

        $("#Fecha").change(cargarHorasDisponibles);
        });
    </script>
}