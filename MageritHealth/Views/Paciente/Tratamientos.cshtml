@model MageritHealth.Models.ViewModels.TratamientosViewModel
@{
    Layout = "_PacienteLayout";
    ViewData["Title"] = "Mis Tratamientos";
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Mis Tratamientos</h3>
            <p class="text-muted small">Consulta tu medicación actual y el historial de prescripciones pasadas.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-capsule-pill text-success me-2"></i>Medicación Activa
            </h5>

            @if (Model.MedicacionActiva != null && Model.MedicacionActiva.Any())
            {
                foreach (var prescripcion in Model.MedicacionActiva)
                {
                    <div class="patient-card p-4 mb-3 border-start border-success border-5 shadow-sm position-relative">
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">En curso</span>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@prescripcion.Medicamento.NombreComercial <span class="text-muted fs-6 fw-normal">(@prescripcion.Medicamento.Concentracion)</span></h5>
                                <small class="text-muted">@prescripcion.Medicamento.PrincipioActivo | @prescripcion.Medicamento.Formato</small>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-3 border mb-3">
                            <p class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Instrucciones:</p>
                            <p class="mb-0 text-muted ms-4">@prescripcion.Instrucciones</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small">
                            <div class="text-muted">
                                <i class="bi bi-calendar-event me-1"></i> <b>Inicio:</b> @prescripcion.FechaInicio.ToString("dd MMM yyyy")
                            </div>

                            @if (prescripcion.FechaFin != null)
                            {
                                <div class="text-danger fw-bold">
                                    <i class="bi bi-calendar-x me-1"></i> <b>Fin:</b> @prescripcion.FechaFin.ToString("dd MMM yyyy")
                                </div>
                            }
                            else
                            {
                                <div class="text-success fw-bold">
                                    <i class="bi bi-infinity me-1"></i> <b>Fin:</b> Tratamiento crónico
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light border shadow-sm text-center p-4">
                    <i class="bi bi-check-circle text-success fs-2 mb-2"></i>
                    <p class="mb-0 text-muted">No tienes medicación activa en este momento.</p>
                </div>
            }


            <h5 class="fw-bold text-dark mb-3 mt-5">
                <i class="bi bi-clock-history text-secondary me-2"></i>Historial de Medicación
            </h5>

            <div class="patient-card shadow-sm overflow-hidden border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-muted">
                            <tr>
                                <th class="ps-4">MEDICAMENTO</th>
                                <th>FORMATO</th>
                                <th>PERIODO</th>
                                <th class="text-end pe-4">ESTADO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.HistorialMedicacion != null && Model.HistorialMedicacion.Any())
                            {
                                foreach (var historico in Model.HistorialMedicacion)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@historico.Medicamento.NombreComercial (@historico.Medicamento.Concentracion)</div>
                                            <div class="small text-muted">@historico.Medicamento.PrincipioActivo</div>
                                        </td>
                                        <td>@historico.Medicamento.Formato</td>
                                        <td>
                                            <div class="small text-dark">@historico.FechaInicio.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">al @(historico.FechaFin.ToString("dd MMM yyyy") ?? "N/A")</div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Finalizado</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        No hay registros de medicación pasada.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="patient-card p-4 mb-4 border-start border-danger border-5 shadow-sm">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-4 me-2"></i>
                    <h6 class="fw-bold mb-0 text-danger">Alergias Conocidas</h6>
                </div>

                @if (Model.Alergias != null && Model.Alergias.Any())
                {
                    foreach (var alergia in Model.Alergias)
                    {
                        string badgeColor = "bg-warning text-dark"; // Por defecto leve/moderada
                        if (alergia.Severidad?.ToLower() == "grave" || alergia.Severidad?.ToLower() == "critica")
                        {
                            badgeColor = "bg-danger";
                        }

                        <div class="p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 mb-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">@alergia.Nombre</span>
                            <span class="badge @badgeColor">@(string.IsNullOrEmpty(alergia.Severidad) ? "No esp." : alergia.Severidad)</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-3 bg-light rounded-3 border">
                        <p class="mb-0 text-muted small"><i class="bi bi-shield-check me-2 text-success"></i>No constan alergias registradas.</p>
                    </div>
                }

                <p class="small text-muted mt-3 mb-0">
                    Tu médico tiene esta información en cuenta al recetar. Si detectas alguna reacción adversa, acude a urgencias.
                </p>
            </div>

            <div class="patient-card p-4 border-start border-info border-5 shadow-sm bg-info bg-opacity-10">
                <h6 class="fw-bold text-info text-darken mb-3"><i class="bi bi-info-circle-fill me-2"></i>Renovación de Recetas</h6>
                <p class="small text-dark mb-3">
                    Recuerda que para los tratamientos crónicos, debes solicitar una cita de revisión antes de que caduque tu prescripción actual para que el especialista pueda renovarla.
                </p>
                <a asp-controller="Paciente" asp-action="SolicitarCita" class="btn btn-sm btn-info text-white fw-bold w-100 shadow-sm">
                    Solicitar Cita de Revisión
                </a>
            </div>

        </div>
    </div>
</div>