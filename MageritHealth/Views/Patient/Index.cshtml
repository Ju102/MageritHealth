@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Resumen de Salud: <span class="text-primary">María Díaz Martín</span></h4>
        <span class="badge bg-soft-green text-success">Estado General: Excelente</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-action"><i class="bi bi-download me-2"></i>Exportar Informe</button>
        <button class="btn btn-clinic-main btn-action"><i class="bi bi-calendar-plus me-2"></i>Nueva Cita</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card border-top border-primary border-4">
                    <div class="text-muted small">Peso Actual</div>
                    <div class="fs-4 fw-bold">65.2 <small class="text-muted">kg</small></div>
                    <div class="text-success small"><i class="bi bi-arrow-down"></i> 0.5kg este mes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card border-top border-info border-4">
                    <div class="text-muted small">IMC</div>
                    <div class="fs-4 fw-bold">22.8</div>
                    <div class="badge bg-light text-dark fw-normal">Rango Saludable</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card border-top border-danger border-4">
                    <div class="text-muted small">Presión (Promedio)</div>
                    <div class="fs-4 fw-bold">118/75</div>
                    <div class="text-muted" style="font-size: 0.7rem;">Última toma: Ayer</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card border-top border-warning border-4">
                    <div class="text-muted small">Glucosa (Ayunas)</div>
                    <div class="fs-4 fw-bold">94 <small class="text-muted">mg/dL</small></div>
                    <div class="text-success small"><i class="bi bi-check-circle"></i> Estable</div>
                </div>
            </div>
        </div>

        <div class="stat-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold"><i class="bi bi-graph-up me-2"></i>Tendencia de Presión Arterial (Últimos 7 días)</h6>
                <select class="form-select form-select-sm w-auto">
                    <option>Sistólica</option>
                    <option>Diastólica</option>
                </select>
            </div>
            <div class="chart-container">
                <div class="chart-bar" style="height: 70%;" title="115 mmHg"></div>
                <div class="chart-bar" style="height: 75%;" title="120 mmHg"></div>
                <div class="chart-bar" style="height: 68%;" title="112 mmHg"></div>
                <div class="chart-bar" style="height: 85%;" title="125 mmHg"></div>
                <div class="chart-bar" style="height: 72%;" title="118 mmHg"></div>
                <div class="chart-bar" style="height: 80%;" title="122 mmHg"></div>
                <div class="chart-bar" style="height: 78%;" title="120 mmHg"></div>
            </div>
            <div class="d-flex justify-content-between mt-2 text-muted small">
                <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
            </div>
        </div>

        <div class="stat-card">
            <h6 class="fw-bold mb-3"><i class="bi bi-clipboard2-pulse me-2"></i>Última Analítica de Sangre (10/02/2026)</h6>
            <div class="table-responsive">
                <table class="table table-hover table-analytics">
                    <thead>
                        <tr>
                            <th>Parámetro</th>
                            <th>Resultado</th>
                            <th>Referencia</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Hemoglobina</td>
                            <td class="fw-bold">14.2 g/dL</td>
                            <td>12.0 - 15.5</td>
                            <td><span class="text-success"><i class="bi bi-circle-fill small"></i> Normal</span></td>
                        </tr>
                        <tr>
                            <td>Colesterol Total</td>
                            <td class="fw-bold text-warning">205 mg/dL</td>
                            <td>< 200</td>
                            <td><span class="text-warning"><i class="bi bi-exclamation-triangle-fill"></i> Ligeramente alto</span></td>
                        </tr>
                        <tr>
                            <td>Triglicéridos</td>
                            <td class="fw-bold">130 mg/dL</td>
                            <td>< 150</td>
                            <td><span class="text-success"><i class="bi bi-circle-fill small"></i> Normal</span></td>
                        </tr>
                        <tr>
                            <td>Hierro</td>
                            <td class="fw-bold">95 µg/dL</td>
                            <td>60 - 170</td>
                            <td><span class="text-success"><i class="bi bi-circle-fill small"></i> Normal</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="card bg-primary text-white border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="small text-white-50 uppercase fw-bold mb-2">Siguiente Cita</div>
                <div class="d-flex align-items-center">
                    <div class="display-6 fw-bold me-3">05</div>
                    <div>
                        <div class="fw-bold">Marzo, 2026</div>
                        <div class="small">10:30 AM</div>
                    </div>
                </div>
                <hr class="my-3 opacity-25">
                <div class="small"><i class="bi bi-geo-alt me-1"></i> Planta 3 - Consulta 302</div>
                <div class="small"><i class="bi bi-person-md me-1"></i> Dr. Luis García</div>
            </div>
        </div>

        <div class="stat-card">
            <h6 class="fw-bold mb-3">Medicación en curso</h6>
            <div class="mb-3 p-2 rounded bg-light border-start border-primary border-3">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold small">Lorazepam</span>
                    <span class="text-muted" style="font-size: 0.7rem;">21:00</span>
                </div>
                <div class="text-muted small">1 comprimido antes de dormir</div>
            </div>
            <div class="mb-3 p-2 rounded bg-light border-start border-info border-3">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold small">Vitamina D3</span>
                    <span class="text-muted" style="font-size: 0.7rem;">09:00</span>
                </div>
                <div class="text-muted small">1 cápsula con el desayuno</div>
            </div>
            <a href="#" class="btn btn-sm btn-link text-decoration-none w-100 mt-2">Gestionar Recetas</a>
        </div>

        <div class="mt-4 p-3 rounded-3 bg-white shadow-sm border">
            <h6 class="fw-bold text-danger"><i class="bi bi-bell-fill me-2"></i>Recordatorios</h6>
            <ul class="list-unstyled mb-0 mt-2" style="font-size: 0.85rem;">
                <li class="mb-2"><i class="bi bi-dot text-danger"></i> Tienes 1 receta pendiente de renovar.</li>
                <li><i class="bi bi-dot text-primary"></i> Beber 2L de agua diarios (Objetivo médico).</li>
            </ul>
        </div>
    </div>
</div>