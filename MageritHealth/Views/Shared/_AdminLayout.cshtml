<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Administración</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg admin-navbar sticky-top py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center text-white" href="#">
                <i class="bi bi-shield-lock-fill text-info me-2 fs-3"></i>
                <span class="fw-bold">CLÍNICA PRIVADA <small class="text-white-50 fw-normal ms-2">| Administración</small></span>
            </a>

            <div class="collapse navbar-collapse justify-content-center">
                <div class="navbar-nav">
                    <a class="nav-link-custom active" href="#">Resumen General</a>
                    <a class="nav-link-custom" href="#">Personal Médico</a>
                    <a class="nav-link-custom" href="#">Pacientes</a>
                    <a class="nav-link-custom" href="#">Especialidades</a>
                    <a class="nav-link-custom" href="#">Reportes</a>
                </div>
            </div>

            <div class="d-flex align-items-center">
                <div class="text-end me-3 d-none d-md-block text-white">
                    <div class="fw-bold small">Carlos Gómez</div>
                    <div class="text-info" style="font-size: 0.7rem;">SuperAdmin | IT Dept</div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-info rounded-circle p-2" data-bs-toggle="dropdown">
                        <i class="bi bi-person-gear fs-5"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-sliders me-2"></i>Ajustes del Sistema</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="main-content" style="padding: 2rem; background-color: #f4f6f7;">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>