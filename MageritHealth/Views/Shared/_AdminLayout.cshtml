<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Magerit Health</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MageritHealth.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>

        body {
            background: #f4f7f6;
            font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
        }

        .btn-clinic-main {
            background: #0d6efd;
            color: white;
            border-radius: 8px;
        }

            .btn-clinic-main:hover {
                background: #0b5ed7;
                color: white;
            }

        .admin-stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform .2s;
            background: white;
            padding: 20px;
        }

            .admin-stat-card:hover {
                transform: translateY(-5px);
            }

        .table-admin tbody tr {
            background: white;
        }

            .table-admin tbody tr:hover {
                background: #f8f9fa;
            }

        .navbar .nav-link {
            font-weight: 500;
        }

            .navbar .nav-link.active {
                color: white !important;
            }

    </style>

</head>

<body>


    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">

        <div class="container-fluid">


            <a class="navbar-brand fw-bold d-flex align-items-center"
               asp-controller="Admin"
               asp-action="Dashboard">

                <i class="bi bi-heart-pulse text-primary me-2 fs-4"></i>

                <span class="fs-5">Magerit Health</span>

                <span class="text-muted ms-1 small">Admin</span>

            </a>


            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminNavbar">

                <i class="bi bi-list text-white fs-3"></i>

            </button>



            <div class="collapse navbar-collapse" id="adminNavbar">


                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link active"
                           asp-controller="Admin"
                           asp-action="Dashboard">

                            <i class="bi bi-grid-1x2-fill me-1"></i>
                            Dashboard

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Usuarios"
                           asp-action="Index">

                            <i class="bi bi-people me-1"></i>
                            Usuarios

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Citas"
                           asp-action="Index">

                            <i class="bi bi-calendar-check me-1"></i>
                            Citas

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Analiticas"
                           asp-action="Index">

                            <i class="bi bi-clipboard-pulse me-1"></i>
                            Analíticas

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Mediciones"
                           asp-action="Index">

                            <i class="bi bi-activity me-1"></i>
                            Mediciones

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Medicamentos"
                           asp-action="Index">

                            <i class="bi bi-capsule-pill me-1"></i>
                            Medicamentos

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Especialidades"
                           asp-action="Index">

                            <i class="bi bi-tag me-1"></i>
                            Especialidades

                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-controller="Antecedentes"
                           asp-action="Index">

                            <i class="bi bi-file-medical me-1"></i>
                            Antecedentes

                        </a>
                    </li>

                </ul>



                <div class="dropdown">

                    <a href="#"
                       class="d-flex align-items-center text-white text-decoration-none dropdown-toggle p-2"
                       id="adminUserDropdown"
                       data-bs-toggle="dropdown">

                        <i class="bi bi-person-circle fs-4 me-2"></i>

                        <div class="d-flex flex-column text-start">

                            <span class="fw-bold small">
                                @Context.User.Identity.Name @Context.User.FindFirst("FullSurname").Value
                            </span>

                            <span class="text-white-50"
                                  style="font-size:.75rem">

                                Admin

                            </span>

                        </div>

                    </a>


                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">

                        <li>

                            <a class="dropdown-item">

                                <i class="bi bi-person-bounding-box me-2"></i>
                                Mi Perfil

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item">

                                <i class="bi bi-gear-fill me-2"></i>
                                Configuración

                            </a>

                        </li>


                        <li><hr class="dropdown-divider"></li>


                        <li>

                            <a class="dropdown-item text-danger"
                               asp-controller="Account"
                               asp-action="Logout">

                                <i class="bi bi-box-arrow-right me-2"></i>
                                Cerrar sesión

                            </a>

                        </li>

                    </ul>

                </div>


            </div>
        </div>

    </nav>



    <main class="container-fluid mt-4">

        @RenderBody()

    </main>



    <footer class="text-center mt-5 mb-4 text-muted small container">

        &copy; @DateTime.Now.Year Magerit Health Centro Médico Global

    </footer>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>