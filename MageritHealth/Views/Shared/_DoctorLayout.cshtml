<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Magerit Health (Médico)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --clinic-primary: #0d6efd;
            --clinic-secondary: #6c757d;
            --clinic-bg: #f8f9fa;
        }

        body {
            background-color: var(--clinic-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar-doctor {
            background: white;
            border-bottom: 1px solid #e0e0e0;
        }

        .nav-link-doc {
            color: var(--clinic-secondary);
            font-weight: 500;
            padding: 0.5rem 1rem;
            transition: all 0.3s;
        }

            .nav-link-doc:hover, .nav-link-doc.active {
                color: var(--clinic-primary);
                background: #e7f1ff;
                border-radius: 8px;
            }

        .doctor-stat-card {
            background: white;
            border: none;
            border-radius: 12px;
            padding: 1.5rem;
            transition: transform 0.2s;
        }

            .doctor-stat-card:hover {
                transform: translateY(-5px);
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-doctor sticky-top mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Doctor" asp-action="Dashboard">
                <i class="bi bi-heart-pulse-fill me-2"></i>Magerit Health
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-doc active" asp-controller="Doctor" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill me-2"></i>Panel
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-doc" href="#">
                            <i class="bi bi-people-fill me-2"></i>Mis Pacientes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-doc" href="#">
                            <i class="bi bi-calendar-event-fill me-2"></i>Agenda
                        </a>
                    </li>
                </ul>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                        <div class="bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-size: 0.8rem;">
                            EM
                        </div>
                        <span class="small fw-bold">Dr. @Context.User.Identity.Name @Context.User.FindFirst("FullSurname").Value</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>