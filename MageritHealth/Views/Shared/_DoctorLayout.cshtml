<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Portal Médico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg clinic-navbar sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <i class="bi bi-heart-pulse-fill text-primary me-2 fs-3"></i>
                <span class="fw-bold text-dark">CLÍNICA PRIVADA <small class="text-muted fw-normal ms-2">| Área Médica</small></span>
            </a>

            <div class="collapse navbar-collapse justify-content-center">
                <div class="navbar-nav">
                    <a class="nav-link-custom active" href="#">Panel Principal</a>
                    <a class="nav-link-custom" href="#">Mis Pacientes</a>
                    <a class="nav-link-custom" href="#">Agenda</a>
                    <a class="nav-link-custom" href="#">Resultados Lab</a>
                </div>
            </div>

            <div class="d-flex align-items-center">
                <div class="input-group me-4 d-none d-lg-flex" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-start-0 clinic-control" placeholder="Buscar DNI o Nombre..." style="padding: 6px 12px;">
                </div>

                <div class="text-end me-3 d-none d-md-block">
                    <div class="fw-bold small">Dr. Luis García</div>
                    <div class="text-muted" style="font-size: 0.7rem;">Medicina General | MED-67890</div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light border rounded-circle p-2" data-bs-toggle="dropdown">
                        <i class="bi bi-person-badge fs-5 text-primary"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person-lines-fill me-2"></i>Mi Perfil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-action="Logout" asp-controller="Account"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="main-content" style="padding: 1.5rem 2rem;">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>