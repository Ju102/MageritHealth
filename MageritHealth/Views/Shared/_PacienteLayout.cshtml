<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Magerit Health (Paciente)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --patient-primary: #0ea5e9;
            --patient-success: #10b981;
            --patient-bg: #f0f9ff;
        }

        body {
            background-color: var(--patient-bg);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .navbar-patient {
            background: white;
            border-bottom: 2px solid #e0f2fe;
        }

        .nav-link-pac {
            color: #64748b;
            font-weight: 500;
            border-radius: 10px;
            margin: 0 0.2rem;
            transition: 0.3s;
        }

            .nav-link-pac:hover, .nav-link-pac.active {
                color: var(--patient-primary);
                background: #f0f9ff;
            }

        .patient-card {
            background: white;
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }

        .btn-request {
            background-color: var(--patient-primary);
            color: white;
            border-radius: 12px;
            font-weight: 600;
        }

            .btn-request:hover {
                background-color: #0284c7;
                color: white;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-patient sticky-top mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-info" asp-controller="Paciente" asp-action="Dashboard">
                <i class="bi bi-heart-pulse-fill me-2"></i>Magerit Health
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a asp-controller="Paciente" asp-action="Dashboard" class="nav-link nav-link-pac"><i class="bi bi-house-door me-2"></i>Inicio</a></li>
                    <li class="nav-item"><a asp-controller="Paciente" asp-action="Citas" class="nav-link nav-link-pac"><i class="bi bi-calendar-date me-2"></i>Mis Citas</a></li>
                    <li class="nav-item"><a class="nav-link nav-link-pac" href="#"><i class="bi bi-file-earmark-medical me-2"></i>Mi Salud</a></li>
                    <li class="nav-item"><a class="nav-link nav-link-pac" href="#"><i class="bi bi-capsule me-2"></i>Tratamientos</a></li>
                </ul>
                <div class="dropdown">
                    <button class="btn border-0 d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                        <span class="me-2 d-none d-md-inline fw-semibold text-muted">@Context.User.Identity.Name @Context.User.FindFirst("FullSurname").Value</span>
                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            MG
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                        <li><a class="dropdown-item rounded-2" asp-controller="Paciente" asp-action="Perfil"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger rounded-2" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> @await RenderSectionAsync("Scripts", required: false)
</body>
</html>